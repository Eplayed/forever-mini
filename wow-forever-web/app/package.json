{
  "name": "wow-forever-app",
  "private": true,
  "version": "0.1.0",
  "description": "无限服中文资料站 · Vue 3 表现层（迁移中，数据仍读 ../src/data）",
  "type": "module",
  "scripts": {
    "sync": "python3 ../tools/app-assets.py",
    "dev": "python3 ../tools/app-assets.py && vite",
