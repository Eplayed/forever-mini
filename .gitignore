# 系统
.DS_Store
Thumbs.db

# 依赖与构建产物
node_modules/
miniprogram_npm/
dist/
*.log

# 微信开发者工具本地配置（含个人登录态与本地端口）
for-mini/project.private.config.json

# 临时验证脚本
.tmp/

# 译名体检的页面缓存
.audit-cache/

# Python 导入脚本时生成的字节码缓存（tools/audit-translations.py 被 extract-*.py 复用时会落盘）
__pycache__/

# 像素视觉基线（tools/visual-check.py）。不进仓库的两个理由：
# 1) 只有"同一台机 + 同一个 Chrome + 同一套本地字体"取出来的图才可比，换机器必须重冻，
#    存进仓库等于存一份在别人机器上必然全红的假标准；
# 2) 21 条路由 × 两视口降采样后仍要十几 MB，PNG 在 git 里压不动，每轮重冻就永久多留一份。
# 基线对应的提交号写在 baseline.json 里；2026-10-24 起这一份拍的是 app/dist，
# 要重冻：cd app && npm run build && python3 tools/visual-check.py --make
wow-forever-web/docs/screenshots/baseline/
wow-forever-web/docs/screenshots/visual-diff-*/

# 历史截图批次归档（2026-10-13 起：旧 check-* 整批 tar 后移出 git，只留本地）。
# 仓库历史里仍带着归档前的原图，新克隆体积要等历史重写才会真正变小。
wow-forever-web/docs/screenshots-archive/

# AI 出图的原图（PNG，几十 MB）；入库的是 app/img/gen/ 里裁过并转 webp 的那三份
vibe_images/

# Trae 本地分享包产物（非项目源码）
.trae-html-share-packages/

# 工具运行期临时清单
wow-forever-web/tools/_tmp_*

# NGA 采集产物（含玩家原创正文，绝不入库：远程仓库公开=转载）
# 采集脚本 tools/scrape-nga-forever.py 入库，它产出的数据不入库。
wow-forever-web/docs/nga-hot/
# 登录 cookie 与 jar 在 ~/.nga/ 下（仓库外），这里只是防一手误放进来
.nga/

# 上线包（tools/release-package.py）。不入库的理由：一份 60 MB，且每版内容都由 git 里的产物与数据可复现；
# 进仓库要留的是摘要 docs/data-base/release-*/package-summary.json（含整包与逐文件哈希），回滚位 release/latest.json 是本机状态。
wow-forever-web/release/

# OSS 写凭证（tools/oss-release.js 的本地凭证文件）。放在仓库根，不在小程序目录里，
# 这样微信打包器不可能把它带进代码包；密钥一律不许进 git。
.oss-env

# build-xr-probe.py 生成的扫码预览工程：可随时重生成，且里面烘了一条 OSS 地址，不入库
/xr-probe/
/xr-probe-remote/
