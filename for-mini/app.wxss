/* 设计令牌：与网页端 wow-forever-web/app/src/styles/tokens.css 同一套值（2026-10-12 换轨后的现行版），
   不是 docs/UI.md §2.0 那段历史。设计依据与官网实测值见
   wow-forever-web/docs/UI-小程序首页与令牌对齐-2026-10-21.md。
   规则：页面 wxss 里不许再写裸色值，要新色先加到这里。小程序主包不放中文字体，
   标题层级靠字号与字重拉开（官网那套方正兰亭黑是商用授权，不抄）。 */
page {
  --bg: #0b0f16;
  --panel: #1b2335;
  --panel-2: #131a28;
  /* 玻璃底的面色（2026-10-24 站主二次指令：要更像玻璃；同日三次指令：毛玻璃还不够）。
     基色比 --panel-2 亮一档（28,39,60）、不透明度 0.46——面色越接近页底色，透出来就越像"没变"，
     亮一档的底色 + 重虚化才是磨砂感的主来源（0.5/19,26,40 那一版卡片内部只有 15,20,31，
     跟页底 11,15,22 差不到一档）。
     只有铺了底图的三个 tab 页用它，别的页面仍是纯色，不受影响。 */
  --panel-glass: rgba(28, 39, 60, 0.46);
  /* 玻璃的四件质感：顶部一道 2px 反光沿、上半一小段乳白（只到 22% 高，再往下铺就会把
     20rpx 那档小字压到 AA 线下——2026-10-24 试过占 16% 的成片高光带，最差那档掉到 3.98:1，
     而且它当时还把 m01 那把"按颜色找卡片顶边"的探针带偏过，那把探针现已改成量几何）、
     底部压暗（卡片自己的厚度）、身后画面重虚化。
     虚化半径 30px + 提饱和提亮，是"磨砂"而不是"透明"的那一分。
     值只写在这里，页面只引用令牌。老内核不认 backdrop-filter 时那一条整条忽略，
     退化成一层面色玻璃 + 一片已经糊掉的环境底图，版式不受影响（真机效果待人工复核）。 */
  --glass-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0px, rgba(255, 255, 255, 0) 2px, rgba(255, 255, 255, 0.055) 2px, rgba(255, 255, 255, 0.012) 22%, rgba(11, 15, 22, 0.06) 55%, rgba(11, 15, 22, 0.30) 100%);
  --glass-blur: blur(30px) saturate(180%) brightness(1.10);
  --glass-line: rgba(255, 255, 255, 0.22);
  --elev: #2a364c;
  --leather: #2a1c1c;
  --foot: #080b11;

  --line: #2c3850;
  --line-2: #3a465e;
  --gold: #c8a35c;
  --gold-hi: #e6c886;
  --gold-hot: #f8b700;
  --gold-deep: #a8863f;
  --accent: var(--gold);
  --accent-ink: #1a1408;
  --gold-line: rgba(200, 163, 92, 0.30);
  --gold-line-soft: rgba(200, 163, 92, 0.15);
  --gold-glow: rgba(200, 163, 92, 0.12);

  --azure: #49aee9;
  --azure-deep: #1d8dcd;
  --blue: var(--azure);

  /* 阵营两色（2026-10-22 职业详情按联盟/部落分框）。
     色相与网页端 app/src/lib/glyph.js 的 FACTION_HUE 同一组（联盟 212 / 部落 8），
     两端不是各挑一次颜色；底色与描边是同一色相的低不透明度版本。
     注意：这两个框只靠颜色与左右位置分辨阵营（站主明确不要框内再写"联盟/部落"），
     对分不出蓝红的玩家这一处是破例——记在 UI 走查清单里。 */
  --fac-alliance: #49aee9;
  --fac-alliance-line: rgba(73, 174, 233, 0.45);
  --fac-alliance-bg: rgba(73, 174, 233, 0.10);
  --fac-horde: #c1504a;
  --fac-horde-line: rgba(193, 80, 74, 0.48);
  --fac-horde-bg: rgba(193, 80, 74, 0.11);

  /* 物品品质六档：与网页端 app/src/styles/tokens.css 同一组值（游戏内通用色），
     掉落反查与副本掉落两页都从这里取，页面里不许再写裸色 */
  --q0: #9d9d9d;
  --q1: #ffffff;
  --q2: #1eff00;
  --q3: #4aa3ff;
  --q4: #a335ee;
  --q5: #ff8000;

  --txt: #e9e2d2;
  --txt-title: #f2ead8;
  --txt-dim: #aeb6c4;
  --txt-muted: #8a93a5;
  --txt-hint: #7e8696;

  /* 分级四态：有序量，用明度阶梯 + 徽标形状 + 文字三通道，不靠色相 */
  --lv0: #e2ecf5;
  --lv1: #b6c2cd;
  --lv2: #a0a7b0;
  --lv3: #8c939c;

  --ok: #67c267;
  --warn: #dd9f44;
  --bad: #c75c5c;
  --txt-alert: #ff9b8f;
  --txt-caution: #f0c67e;
  /* 提示条底色：只在这里定义一次，页面里不许再写 rgba */
  --warn-bg: rgba(221, 159, 68, 0.12);
  --bad-bg: rgba(199, 92, 92, 0.16);

  /* 底图压暗层（2026-10-22 首页配图）：页面背景与卡片背景都要盖一层暗底，
     不然原画的亮部会把文字吃掉。同样只在这里写 rgba，页面里引用令牌。
     2026-10-24：从 0.88 降到 0.76。这张官方天裔图本身是亮蓝的（整幅均值 110,148,177，
     顶部一条 p90 到 184,219,240），压到 0.88 只剩 12% 的画面，等于把图压成一块纯色，
     卡片再怎么透也透不出东西。0.76 留 24%（是原来的两倍）。
     代价是可读性，所以这一版是逐行文字量出来的，不是估的：实拍两帧对照，
     每个文字元素自己那一小块的主色 vs 它的令牌色，最差的一档是倒计时卡底部那行
     20rpx 说明文字（--txt-muted）5.21:1，AA 线是 4.5；其余从 6.05 到 12.74。
     再往下压暗就换来对比度，往上就换来透，要哪一头由站主看实拍定。 */
  --scrim-page: rgba(11, 15, 22, 0.76);
  --scrim-card: rgba(11, 15, 22, 0.58);
  --scrim-card-b: rgba(11, 15, 22, 0.86);
  --scrim-pop: rgba(8, 11, 17, 0.78);
  --lead: #8a93a5;

  --sunk: #0d121c;
  --field: #101725;
  --hatch: #46506a;

  /* 切角铭牌：与网页同一组数值（CTA 10px、铭牌 14px） */
  --cut-cta: 10px;
  --cut-plate: 14px;
  --r-ctl: 3px;

  background: var(--bg);
  color: var(--txt);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

button {
  border: 0;
}

button::after {
  border: 0;
}

.wrap {
  padding: 24rpx 28rpx 60rpx;
}

/* 整页环境底图（2026-10-24 站主：三页卡片毛玻璃还不够）。
   原因不在配方，在"没有东西可透"：那张页面底图是 widthFix 锚在顶部的，只有上面约 703rpx 有图，
   再往下卡片背后本来就是纯色页底，玻璃透得再狠也透不出东西。
   这一层是同一张图 fixed 铺满视口、并且自己先糊掉（filter 是画在图上的，比 backdrop-filter 通用），
   只当一片柔和的色场给卡片去透；它压在 .pagebg-scrim 那层暗底下面，所以不会亮过顶部那张原图。
   三个 tab 页共用，写在全局；图取不到时（bgUrl 为空）这一层整个不渲染。 */
.pagebg-ambient {
  position: fixed;
  left: -40px;
  top: -40px;
  width: calc(100% + 80px);
  height: calc(100vh + 80px);
  z-index: 0;
  filter: blur(26px) saturate(150%);
}

.card {
  background: var(--panel-2);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--txt-title);
  margin-bottom: 12rpx;
}

.muted {
  color: var(--txt-dim);
  font-size: 24rpx;
}

.gold {
  color: var(--gold);
}

.row {
  display: flex;
  align-items: center;
}

.spacer {
  flex: 1;
}

/* 顶部那道金色发丝线：签名动作之一，只给页面第一块用 */
.hairline {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(200, 163, 92, 0) 0%, var(--gold) 42%, var(--gold) 58%, rgba(200, 163, 92, 0) 100%);
  margin-bottom: 22rpx;
}

/* 切角铭牌：右上角切一刀。老基库不支持 clip-path 时退化成直角 + 铜金描边，不塌版 */
.plate {
  clip-path: polygon(0 0, calc(100% - var(--cut-cta)) 0, 100% var(--cut-cta), 100% 100%, 0 100%);
}

/* 完整度徽标：全站统一，颜色走明度阶梯（有序），形状与文字是第二、第三通道 */
.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 2rpx;
  border: 1rpx solid var(--line-2);
  font-size: 20rpx;
  line-height: 1.8;
}

.badge-L0 {
  color: var(--accent-ink);
  background: var(--lv0);
  border-color: var(--lv0);
  font-weight: 600;
}

.badge-L1 {
  color: var(--sunk);
  background: var(--lv1);
  border-color: var(--lv1);
}

.badge-L2 {
  color: var(--txt);
  background: transparent;
  border-color: var(--lv2);
  border-style: dashed;
}

.badge-L3 {
  color: var(--lv3);
  background: transparent;
  border-color: var(--lv3);
  border-style: dotted;
}

.notice {
  background: var(--warn-bg);
  border: 1rpx solid var(--warn);
  border-left-width: 6rpx;
  color: var(--txt-caution);
  border-radius: var(--r-ctl);
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.notice-bad {
  background: var(--bad-bg);
  border-color: var(--bad);
  color: var(--txt-alert);
}

/* 控件：主行动用铜金实心，次行动用描边，选中态才上高饱和金 */
.btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--gold);
  border-radius: var(--r-ctl);
  color: var(--gold-hi);
  font-size: 24rpx;
  background: transparent;
  line-height: 1.6;
}

.btn-primary {
  background: var(--gold);
  color: var(--accent-ink);
  font-weight: 600;
}

.btn-on {
  background: var(--gold-glow);
  border-color: var(--gold-hot);
  color: var(--gold-hot);
}

.chip {
  display: inline-block;
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 2rpx;
  font-size: 24rpx;
  color: var(--txt-dim);
}

.chip-on {
  color: var(--accent-ink);
  background: var(--gold-hot);
  border-color: var(--gold-hot);
  font-weight: 600;
}

/* 「全部」是这一维度的默认值，选中它不代表玩家做了筛选：
   高饱和金只留给真正生效的筛选项，两排同时亮金会看不出"现在筛了哪一条" */
.chip-all.chip-on {
  color: var(--gold-hi);
  background: var(--gold-glow);
  border-color: var(--gold);
  font-weight: 400;
}

/* 职业格（2026-10-22 站主：首页与职业页都用"一排圆形职业图标、超出往下排、不要横向滚动条"）。
   一行五格：750rpx 屏宽下每格 138rpx，装得下 96rpx 圆图标 + 三字名；第九个自己换行。
   用 flex 不用 display:grid，是为了不在老内核上赌层叠支持。两个页面共用这一份，别各写一套。 */
.cls9 {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx 10rpx;
}

.cls {
  flex: 0 0 20%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 14rpx 4rpx 10rpx;
  border: 1rpx solid transparent;
  border-radius: var(--r-ctl);
}

/* 选中态三通道：金色描边 + 底色抬起 + 名字变金，不只靠颜色（暗光与色盲也分得出） */
.cls-on {
  background: var(--panel);
  border-color: var(--gold);
}

.cls-name {
  font-size: 22rpx;
  color: var(--txt-dim);
  margin-top: 8rpx;
}

.cls-on .cls-name {
  color: var(--gold-hi);
}

.foot {
  color: var(--txt-muted);
  font-size: 22rpx;
  text-align: center;
  padding: 32rpx 0 8rpx;
  border-top: 1rpx solid var(--gold-line-soft);
  margin-top: 8rpx;
}
