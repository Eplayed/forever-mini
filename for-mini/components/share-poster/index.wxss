.sp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: var(--scrim-pop);
}

.sp-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 95;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding: 22rpx;
  background: var(--panel);
  border: 2rpx solid var(--forge-edge);
  border-radius: 14rpx;
  box-shadow: var(--forge-shadow);
  box-sizing: border-box;
}

.sp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.sp-head-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.sp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold-hi);
}

.sp-sub {
  font-size: 22rpx;
  color: var(--txt-muted);
}

.sp-close {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--txt-dim);
}

.sp-stage {
  flex: 1;
  min-height: 360rpx;
  max-height: 58vh;
  overflow-y: auto;
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.sp-img {
  display: block;
  width: 100%;
  border-radius: 6rpx;
}

.sp-state {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.sp-loading {
  color: var(--txt-dim);
  font-size: 26rpx;
}

.sp-err {
  color: var(--txt-alert);
  font-size: 25rpx;
}

.sp-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 14rpx;
}

.sp-page-num {
  font-size: 24rpx;
  color: var(--txt-dim);
}

.sp-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.sp-btn {
  flex: 1;
  margin: 0;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
  color: var(--txt);
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
}

.sp-btn::after {
  border: 0;
}

.sp-btn-gold {
  border-color: var(--forge-edge-active);
  background: var(--forge-surface-active);
  color: var(--gold-hi);
  font-weight: 700;
}

.sp-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--txt-muted);
}

.sp-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}
