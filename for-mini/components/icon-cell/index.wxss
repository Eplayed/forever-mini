.ic {
  overflow: hidden;
  border-radius: 2rpx;
  border: 1rpx solid var(--line-2);
  box-sizing: border-box;
  flex-shrink: 0;
}

.ic-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ic-sm {
  width: 56rpx;
  height: 56rpx;
}

.ic-md {
  width: 88rpx;
  height: 88rpx;
}

/* 首页职业格（2026-10-22 站主改版：一排圆形职业图标，默认选中战士）。
   圆形是这一格专用的，别拿 md 去凑——md 是 88rpx 直角，职业格要 96rpx 圆。 */
.ic-cls {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border-color: var(--line-2);
}

/* 列表行里的横条缩略图：宽扁形，跟 md 的正方形不是一回事 */
.ic-wide {
  width: 132rpx;
  height: 84rpx;
}

.ic-hero {
  width: 100%;
  height: 220rpx;
  border-radius: var(--r-ctl);
}

.ic-fb {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-txt {
  font-size: 24rpx;
  color: var(--txt-dim);
  padding: 0 12rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}

.ic-hero .ic-txt {
  font-size: 24rpx;
}
