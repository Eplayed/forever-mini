<view class="wrap">
  <view wx:if="{{notFound}}" class="card empty">
    <view>这座本的掉落名单里没有这件装备。</view>
    <view class="muted">可能是分享出去的编号过期了，也可能是这件换了一座本。回到那座本按首领找。</view>
    <view class="btn gold" bindtap="onOpenDungeon">回到这座本</view>
  </view>

  <block wx:elif="{{loaded}}">
    <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
      这批数据的结构比当前小程序新，字段可能显示不全。请更新小程序后再看。
    </view>
    <view wx:elif="{{needOnline}}" class="notice">
      现在是打包快照，<text class="bold">装备的属性行要联网才能取</text>。
    </view>
    <view wx:elif="{{offline}}" class="notice">
      当前显示的是{{sourceText}}，可能不是最新核对结果。
    </view>

    <view class="card head">
      <view class="row">
        <view class="head-face">
          <icon-cell src="{{iconUrl}}" size="md" label="{{name}}" />
        </view>
        <view class="head-main">
          <view class="head-name q-{{q}}">{{name}}<text wx:if="{{missing}}" class="todo">中文名待核</text></view>
          <view class="muted head-meta">
            <text>{{qualityText}}</text>
            <text wx:if="{{type}}"> · {{type}}</text>
            <text wx:if="{{ilvl}}"> · 装等 {{ilvl}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{stText}}" class="st-badge">{{stText}}</view>
    </view>

    <view wx:if="{{st.length}}" class="card">
      <view class="card-title">属性</view>
      <view class="st-line {{item.said ? 'st-said' : ''}}" wx:for="{{st}}" wx:key="index">{{item.t}}</view>
    </view>
    <view wx:else class="card muted">{{idNote}}</view>

    <view class="card">
      <view class="frow">
        <view class="fkey">掉落于</view>
        <view class="fval">
          <view>{{boss || '这座还没标首领'}}</view>
          <view class="muted fnote">{{dungeon}}</view>
        </view>
      </view>
      <view class="frow" wx:if="{{sell}}">
        <view class="fkey">商人卖价</view>
        <view class="fval">{{sell}}</view>
      </view>
      <view class="frow">
        <view class="fkey">物品编号</view>
        <view class="fval"><text class="mono" bindtap="onCopyId">{{itemId}}（点一下复制）</text></view>
      </view>
    </view>

    <view class="btn row-btn" bindtap="onOpenDungeon">看这座本</view>

    <view class="muted grade">{{gradeNote}}</view>
    <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
  </block>

  <view wx:else class="card muted">正在取这件装备…</view>
</view>
