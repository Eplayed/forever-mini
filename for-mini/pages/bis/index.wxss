/* 配装页。颜色一律吃 app.wxss 的令牌，这里不写裸色值（与首页/副本页同一条规矩）。
   品质色与「两家」角标都回令牌：q-1…q-5 用 --q1…--q5，一致绿 / 分歧琥珀 / 没列灰。 */

.h1 {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--txt-title);
  letter-spacing: 1rpx;
}

.note2 {
  font-size: 20rpx;
  color: var(--txt-muted);
  line-height: 1.6;
  margin-top: 10rpx;
}

/* —— 职业条 —— */
.rail {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.rtab {
  display: inline-block;
  width: 132rpx;
  margin-right: 12rpx;
  padding: 14rpx 6rpx 12rpx;
  text-align: center;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  white-space: normal;
  vertical-align: top;
}

.rtab-on,
.rtab.on {
  border-color: var(--gold);
  background: var(--panel);
}

.rtab-n {
  font-size: 22rpx;
  color: var(--txt-dim);
  margin-top: 6rpx;
}

.rtab-c {
  font-size: 18rpx;
  color: var(--txt-muted);
}

.bhead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.bt {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--txt-title);
}

.bn {
  font-size: 20rpx;
  color: var(--txt-muted);
}

.picks {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  align-items: center;
  margin: 12rpx 0 18rpx;
}

.pickrow {
  display: flex;
  flex-wrap: wrap;
}

.pickrow .chip {
  margin-bottom: 6rpx;
}

/* —— 中间那一栏：只有"这一套穿这一身"那一张逐件底图（2026-11-02 起，3D 与按种族的旧底图都撤了） —— */
.stage {
  /* 竖长方形：站主 2026-10-30 要"完整展示整体装备"，竖盒才能从头到脚框进来。
     2026-11-02 里面换成逐件渲的透明底 PNG，框的尺寸一条没改；
     底色沿用 3D 那一版实际铺的 --sunk（图本身透明，玩家看到的就是这一栏的底色，
     所以"背景透明"要成立，这一格就必须是页面自己的色，不能是图里带的一块白）。 */
  position: relative;
  height: 860rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 6rpx;
  overflow: hidden;
  background: var(--sunk);
}

.stage-tag {
  position: absolute;
  left: 12rpx;
  bottom: 10rpx;
  font-size: 20rpx;
  color: var(--txt-dim);
  background: var(--scrim-pop);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.stage-art {
  /* aspectFit：图等比缩到框内，绝不拉伸（站主 2026-11-01 那句"保证不失真"到这一版照样有效）。
     渲染器已经按实测像素留过头脚边距，这里不再裁人。 */
  display: block;
  width: 100%;
  height: 100%;
}

.stage-wait {
  padding: 24rpx 16rpx;
  font-size: 20rpx;
  color: var(--txt-dim);
}

.note-ok {
  border-color: var(--gold-line);
  background: var(--gold-glow);
  color: var(--txt);
}

.note-bad {
  border-color: var(--bad);
  background: var(--bad-bg);
  color: var(--txt-alert);
}

.note-warn {
  border-color: var(--warn);
  background: var(--warn-bg);
  color: var(--txt-caution);
}


.doll-note {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--txt-dim);
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  padding: 10rpx 12rpx;
}

/* —— 属性合计 —— */
.sum {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--line-2);
  padding-top: 14rpx;
}

.sum-h {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
  align-items: baseline;
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.sum-h .b {
  font-size: 24rpx;
  color: var(--txt-title);
  font-weight: 600;
}

.sum-i {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 26rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.sum-v {
  color: var(--ok);
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 6rpx;
}

/* —— 部位一览 —— */
.srow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}

.srow:first-of-type {
  border-top: 0;
}

.s-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.s-top {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.s-slot {
  font-size: 20rpx;
  color: var(--txt-muted);
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
}

.s-name {
  font-size: 26rpx;
  color: var(--txt);
}

.s-unknown {
  font-size: 22rpx;
  color: var(--txt-muted);
}

.q-1 { color: var(--q1); }
.q-2 { color: var(--q2); }
.q-3 { color: var(--q3); }
.q-4 { color: var(--q4); }
.q-5 { color: var(--q5); }
.q-0 { color: var(--q0); }

/* 两类文字分两档（站主 2026-11-02 两轮：先要"属性与副本分色"，看了真机又说"区分不明显"）。
   第一版给来源配 --azure，量下来它与**稀有装备名 --q3 的 RGB 距离只有 34**——
   那一行读起来就是"又一个装备名"，不是"它从哪来"。所以这一档换金色系，并且不只靠色相：
   明度（属性 5.81 / 来源 7.57 对底）、色相（灰 / 金）、形状（来源多一条左竖线）三个通道一起给。
   金色与六个品质色最近的是 --q0 灰（114），而配装页几乎不会有灰色装备。只用令牌，不写裸色。 */
.s-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 6rpx;
}

.s-src {
  font-size: 20rpx;
  color: var(--gold);
  margin-top: 8rpx;
  line-height: 1.5;
  border-left: 3rpx solid var(--gold-line);
  padding-left: 12rpx;
}

/* 这一页原来没定义 .dim（只有宏页与专业页有），弹层里的"装等"一直是继承色，
   而且紧贴着名字挤成一坨——补上，跟属性那一档同色，并留间距。 */
.dim {
  color: var(--txt-muted);
  margin-left: 12rpx;
}

/* 可点的出处：整行与不可点的那行同色（都是金），差别交给那颗更亮一档的金色箭头
   与撑开的命中区。原来这里把整行刷成金，正是它让两档分不开。 */
.s-link {
  padding: 10rpx 0;
}

.s-jump {
  margin-left: 12rpx;
  color: var(--gold-hi);
}

.s-go {
  font-size: 30rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
  align-self: center;
}

/* 弹层里"另一份名单在这一格列的是"那句前缀：中性提示色，不带判词也不带颜色暗示 */
.t-tag {
  font-size: 20rpx;
  color: var(--txt-muted);
}

.sub-t {
  font-size: 22rpx;
  color: var(--gold);
  margin: 16rpx 0 6rpx;
}

.erow {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-top: 1rpx solid var(--line);
}

.e-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

/* —— 备选弹层 —— */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--scrim-pop);
  z-index: 20;
}

.pop {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 70vh;
  background: var(--panel);
  border-top: 1rpx solid var(--gold-line);
  border-radius: 16rpx 16rpx 0 0;
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.pop-h {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pop-t {
  font-size: 26rpx;
  color: var(--txt-title);
  font-weight: 600;
}

.pop-c {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 4rpx;
}

.pop-x {
  font-size: 40rpx;
  line-height: 1;
  color: var(--txt-muted);
  padding: 0 16rpx;
}

.pop-theirs {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
  font-size: 22rpx;
  margin: 12rpx 0;
  padding: 10rpx 12rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
}

.pop-list {
  max-height: 46vh;
}

.prow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}

.p-st {
  font-size: 20rpx;
  color: var(--txt-muted);
  line-height: 1.5;
}
