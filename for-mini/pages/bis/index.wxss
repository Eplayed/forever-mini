.gear-wrap { padding: 20rpx 22rpx 56rpx; }

.gear-wrap .card {
  background: var(--glass-sheen), var(--forge-surface);
  border-color: var(--forge-edge);
  box-shadow: var(--forge-inset), var(--forge-shadow);
}

.h1 {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--txt-title);
  letter-spacing: 1rpx;
  line-height: 1.28;
  padding: 0 2rpx 12rpx;
}

.gear-nav {
  padding: 6rpx 0 12rpx;
  background: var(--forge-shade);
}

.stage-switch { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; }

.stage-tab {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  text-align: center;
  margin: 0;
  padding: 12rpx 4rpx 11rpx;
  line-height: 1.25;
  text-align: center;
  border: 1rpx solid var(--forge-edge);
  background: var(--glass-sheen), var(--forge-surface);
  clip-path: polygon(0 0, calc(100% - 12rpx) 0, 100% 12rpx, 100% 100%, 12rpx 100%, 0 calc(100% - 12rpx));
  box-shadow: var(--forge-inset);
  color: var(--txt);
  transition: transform var(--forge-press) var(--forge-ease);
}
.stage-tab::before {
  position: absolute;
  content: '';
  top: 0;
  left: 9rpx;
  right: 9rpx;
  height: 2rpx;
  background: var(--forge-line);
  opacity: .46;
}
.stage-tab-on {
  border-color: var(--forge-edge-active);
  background: var(--glass-sheen), var(--forge-surface-active);
  box-shadow: var(--forge-inset), var(--forge-focus);
  color: var(--forge-glint);
}
.stage-tab-on::before { opacity: 1; }
.stage-tab:active { border-color: var(--forge-edge-active); transform: scale(.97); }
.stage-tab-title { display: block; font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.stage-tab-info { display: flex; align-items: center; flex-direction: column; gap: 4rpx; margin-top: 7rpx; }
.stage-tab-count { padding: 2rpx 9rpx; background: var(--sunk); border: 1rpx solid var(--forge-edge); color: var(--gold-hi); font-size: 20rpx; line-height: 1.2; }
.stage-tab-hint { color: var(--txt-dim); font-size: 19rpx; white-space: nowrap; }

.rail {
  white-space: nowrap;
  margin-top: 10rpx;
}

.rtab {
  display: inline-block;
  box-sizing: border-box;
  width: 104rpx;
  margin-right: 8rpx;
  padding: 7rpx 4rpx 6rpx;
  text-align: center;
  background: var(--forge-surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  white-space: normal;
  vertical-align: top;
}

.rtab.on {
  border-color: var(--forge-edge-active);
  background: var(--forge-surface-active);
  box-shadow: var(--forge-inset);
}

.rtab-n {
  font-size: 22rpx;
  color: var(--txt-dim);
  line-height: 1.25;
}
.rtab.on .rtab-n { color: var(--forge-glint); font-weight: 600; }
.stage-content { animation: gear-enter var(--forge-enter) var(--forge-ease) both; }
.gear-preview { padding: 16rpx; }

.bhead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.bt {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--txt-title);
}

.bn {
  font-size: 22rpx;
  color: var(--txt-muted);
}

.picks {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  align-items: center;
  margin: 10rpx 0 13rpx;
}

.gear-preview .picks { justify-content: space-between; gap: 6rpx; }
.gear-preview .chip { padding: 6rpx 14rpx; }
.faction-picks .chip { margin-right: 0; margin-left: 8rpx; }
.faction-alliance { --faction-ink: var(--fac-alliance); --faction-haze: var(--forge-alliance-glow); --faction-tint: var(--fac-alliance-bg); }
.faction-horde { --faction-ink: var(--fac-horde); --faction-haze: var(--forge-horde-glow); --faction-tint: var(--fac-horde-bg); }
.faction-on { border-color: var(--faction-ink); background: var(--faction-tint); color: var(--txt-title); font-weight: 700; }
.spec-strip { margin: 10rpx 0 12rpx; }
.raid-note { margin: 2rpx 0 10rpx; }

.pickrow {
  display: flex;
  flex-wrap: wrap;
}

.pickrow .chip {
  margin-bottom: 6rpx;
}

/* —— 中间那一栏：只有"这一套穿这一身"那一张逐件底图（2026-11-02 起，3D 与按种族的旧底图都撤了） —— */
.stage {
  position: relative;
  height: clamp(306rpx, 30vh, 418rpx);
  box-sizing: border-box;
  padding: 8rpx 28rpx 12rpx;
  border: 1rpx solid var(--faction-ink);
  border-radius: var(--r-ctl);
  overflow: hidden;
  background: var(--faction-haze), var(--forge-shade);
  box-shadow: var(--forge-inset), var(--forge-shadow);
}

.stage::before, .stage::after {
  position: absolute;
  content: '';
  width: 26rpx;
  height: 26rpx;
  pointer-events: none;
}
.stage::before { top: 6rpx; left: 6rpx; border-top: 2rpx solid var(--forge-edge-active); border-left: 2rpx solid var(--forge-edge-active); }
.stage::after { right: 6rpx; bottom: 6rpx; border-right: 2rpx solid var(--forge-edge-active); border-bottom: 2rpx solid var(--forge-edge-active); }

.stage-tag {
  position: absolute;
  left: 12rpx;
  bottom: 10rpx;
  font-size: 20rpx;
  color: var(--txt-title);
  background: var(--scrim-pop);
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--forge-edge);
}

.stage-art {
  /* aspectFit：图等比缩到框内，绝不拉伸（站主 2026-11-01 那句"保证不失真"到这一版照样有效）。
     渲染器已经按实测像素留过头脚边距，这里不再裁人。 */
  display: block;
  width: 100%;
  height: 100%;
}

.stage-wait {
  padding: 24rpx 16rpx;
  font-size: 20rpx;
  color: var(--txt-dim);
}

.note-ok {
  border-color: var(--gold-line);
  background: var(--gold-glow);
  color: var(--txt);
}

.note-bad {
  border-color: var(--bad);
  background: var(--bad-bg);
  color: var(--txt-alert);
}

.note-warn {
  border-color: var(--warn);
  background: var(--warn-bg);
  color: var(--txt-caution);
}


.doll-note {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--txt-dim);
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  padding: 10rpx 12rpx;
}

/* —— 属性合计 —— */
.sum {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--line-2);
  padding-top: 14rpx;
}

.sum-h {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
  align-items: baseline;
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.sum-h .b {
  font-size: 24rpx;
  color: var(--txt-title);
  font-weight: 600;
}

.sum-i {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 26rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.sum-v {
  color: var(--ok);
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 6rpx;
}

/* —— 部位一览 —— */
.srow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}

.srow:first-of-type {
  border-top: 0;
}

.s-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.s-top {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.s-slot {
  font-size: 20rpx;
  color: var(--txt-muted);
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
}

.s-name {
  font-size: 26rpx;
  color: var(--txt);
}

.s-unknown {
  font-size: 22rpx;
  color: var(--txt-muted);
}

.q-1 { color: var(--q1); }
.q-2 { color: var(--q2); }
.q-3 { color: var(--q3); }
.q-4 { color: var(--forge-q4-text); }
.q-5 { color: var(--q5); }
.q-0 { color: var(--q0); }

.gear-q2 { --quality-edge: var(--q2); --quality-glow: var(--forge-q2-glow); }
.gear-q3 { --quality-edge: var(--q3); --quality-glow: var(--forge-q3-glow); }
.gear-q4 { --quality-edge: var(--q4); --quality-glow: var(--forge-q4-glow); }
.gear-q5 { --quality-edge: var(--q5); --quality-glow: var(--forge-q5-glow); }
.gear-row { border-left: 3rpx solid var(--quality-edge, var(--line-2)); padding-left: 10rpx; }
.gear-icon { flex: none; line-height: 0; padding: 2rpx; border: 1rpx solid var(--quality-edge, var(--line-2)); box-shadow: 0 0 10rpx var(--quality-glow, transparent); }

/* 两类文字分两档（站主 2026-11-02 两轮：先要"属性与副本分色"，看了真机又说"区分不明显"）。
   第一版给来源配 --azure，量下来它与**稀有装备名 --q3 的 RGB 距离只有 34**——
   那一行读起来就是"又一个装备名"，不是"它从哪来"。所以这一档换金色系，并且不只靠色相：
   明度（属性 5.81 / 来源 7.57 对底）、色相（灰 / 金）、形状（来源多一条左竖线）三个通道一起给。
   金色与六个品质色最近的是 --q0 灰（114），而配装页几乎不会有灰色装备。只用令牌，不写裸色。 */
.s-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 6rpx;
}

.s-src {
  font-size: 20rpx;
  color: var(--gold);
  margin-top: 8rpx;
  line-height: 1.5;
  border-left: 3rpx solid var(--gold-line);
  padding-left: 12rpx;
}

/* 这一页原来没定义 .dim（只有宏页与专业页有），弹层里的"装等"一直是继承色，
   而且紧贴着名字挤成一坨——补上，跟属性那一档同色，并留间距。 */
.dim {
  color: var(--txt-muted);
  margin-left: 12rpx;
}

/* 可点的出处：整行与不可点的那行同色（都是金），差别交给那颗更亮一档的金色箭头
   与撑开的命中区。原来这里把整行刷成金，正是它让两档分不开。 */
.s-link {
  padding: 10rpx 0;
}

.s-jump {
  margin-left: 12rpx;
  color: var(--gold-hi);
}

.s-go {
  font-size: 30rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
  align-self: center;
}

/* 弹层里"另一份名单在这一格列的是"那句前缀：中性提示色，不带判词也不带颜色暗示 */
.t-tag {
  font-size: 20rpx;
  color: var(--txt-muted);
}

.sub-t {
  font-size: 22rpx;
  color: var(--gold);
  margin: 16rpx 0 6rpx;
}

.erow {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-top: 1rpx solid var(--line);
}

.e-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

/* —— 备选弹层 —— */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--scrim-pop);
  z-index: 20;
  animation: gear-mask var(--forge-enter) var(--forge-ease) both;
}

.pop {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 70vh;
  background: var(--glass-sheen), var(--forge-pop);
  border-top: 2rpx solid var(--forge-edge-active);
  border-radius: 16rpx 16rpx 0 0;
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
  box-shadow: var(--forge-inset), var(--forge-shadow);
  animation: gear-sheet var(--forge-enter) var(--forge-ease) both;
}

.pop-h {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pop-t {
  font-size: 26rpx;
  color: var(--txt-title);
  font-weight: 600;
}

.pop-c {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 4rpx;
}

.pop-x {
  font-size: 40rpx;
  line-height: 1;
  color: var(--txt-muted);
  padding: 0 16rpx;
}

.pop-theirs {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
  font-size: 22rpx;
  margin: 12rpx 0;
  padding: 10rpx 12rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
}

.pop-list {
  max-height: 46vh;
}

.prow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}

.p-st {
  font-size: 20rpx;
  color: var(--txt-muted);
  line-height: 1.5;
}

.want-target { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; min-height: 76rpx; margin: 0; padding: 8rpx 13rpx; border: 1rpx solid var(--forge-edge); border-radius: var(--r-ctl); background: var(--sunk); color: var(--gold-hi); font-size: 24rpx; line-height: 1.35; white-space: nowrap; transition: transform var(--forge-press) var(--forge-ease); }
.want-target::after { border: 0; }
.want-target:active, .gear-wrap .chip:active { transform: scale(.97); border-color: var(--forge-edge-active); }
.gear-wrap .chip { transition: transform var(--forge-press) var(--forge-ease); }
.prow .want-target { margin-top: 8rpx; }

.stage.stage-compact { height: auto; min-height: 105rpx; }
.stage-wait { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; font-size: 25rpx; }
.set-actions { display: flex; gap: 10rpx; margin: 12rpx 0 4rpx; }
.set-actions .want-target { flex: 1; min-height: 68rpx; }
.set-primary, .target-selected { background: var(--forge-surface-active); border-color: var(--forge-edge-active); }
.target-selected { animation: gear-confirm var(--forge-enter) var(--forge-ease); }
.selecting { padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); }
.selection-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 12; display: flex; align-items: center; gap: 12rpx; padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--gold-line); background: var(--leather); }
.selection-bar > text { flex: 1; color: var(--txt-title); font-size: 27rpx; }
.selection-bar button[disabled] { opacity: .48; }
.iset-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 0 6rpx; border-top: 1rpx solid var(--line-2); }
.iset-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 14rpx; flex: 1; min-width: 0; }

@keyframes gear-enter {
  from { opacity: .58; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes gear-sheet {
  from { opacity: .65; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes gear-mask { from { opacity: 0; } to { opacity: 1; } }
@keyframes gear-confirm { 50% { transform: scale(.97); } }

@media (prefers-reduced-motion: reduce) {
  .stage-content, .mask, .pop, .target-selected { animation: none; opacity: 1; transform: none; }
  .stage-tab, .want-target, .gear-wrap .chip { transition: none; }
  .stage-tab:active, .want-target:active, .gear-wrap .chip:active { transform: none; }
}
