<view class="wrap">
  <image wx:if="{{bgUrl}}" class="pagebg" src="{{bgUrl}}" mode="widthFix" binderror="onBgError" />
  <view wx:if="{{bgUrl}}" class="pagebg-scrim"></view>
  <view class="fg">
  <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
    请更新小程序以查看最新资料。
  </view>
  <view wx:elif="{{offline}}" class="notice">
    当前离线，首领与掉落需联网查看。
  </view>

  <view class="search">
    <input class="search-input" placeholder="搜索副本中英文名" value="{{kw}}" bindinput="onKw" confirm-type="search" />
    <view class="fav-btn {{onlyFav ? 'fav-btn-on' : ''}}" bindtap="onFavOnly">只看收藏</view>
  </view>

  <scroll-view class="chips" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="chip {{item.key === 'all' ? 'chip-all' : ''}} {{activeKind === item.key ? 'chip-on' : ''}}" wx:for="{{kinds}}" wx:key="key" data-kind="{{item.key}}" bindtap="onKind">{{item.label}}</view>
    <view class="chip chip-src" bindtap="onLoots">掉落反查 ›</view>
  </scroll-view>

  <view wx:if="{{recent.length && !kw && activeKind === 'all' && !onlyFav}}" class="card">
    <view class="card-title">最近看过</view>
    <view class="mini-row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <text class="mini-name">{{item.title}}</text>
      <text class="muted mini-sub">{{item.rangeText}}</text>
    </view>
  </view>

  <view wx:if="{{empty}}" class="card empty">
    <view>没有符合条件的副本。</view>
    <view class="muted">换个关键词，或把筛选切回「全部」。</view>
  </view>

  <view wx:if="{{!loaded}}" class="card muted">正在取副本名单…</view>

  <view wx:if="{{list.length}}" class="dgrid">
    <view class="drow" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen" hover-class="drow-pressed">
      <view class="drow-cover">
        <icon-cell src="{{item.artUrl}}" size="tile" label="{{item.title}}" />
        <view class="drow-cover-shade"></view>
        <text class="drow-kind">{{item.kindLabel}}</text>
        <view class="fav {{item.fav ? 'fav-active' : ''}}" role="button"
              aria-label="{{item.fav ? '取消收藏' : '收藏'}}" data-id="{{item.id}}" catchtap="onFav">{{item.fav ? '★' : '☆'}}</view>
      </view>
      <view class="drow-main">
        <view class="drow-title">{{item.title}}</view>
        <view wx:if="{{!item.enMissing && item.nameEn !== item.title}}" class="drow-en">{{item.nameEn}}</view>
        <view class="drow-meta">
          <text class="drow-level">{{item.rangeText}}</text>
          <text wx:if="{{item.faction}}" class="drow-faction">{{item.faction}}</text>
        </view>
        <view wx:if="{{item.zoneCn}}" class="drow-zone">{{item.zoneCn}}</view>
      </view>
    </view>
  </view>

  <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
  </view>
</view>

