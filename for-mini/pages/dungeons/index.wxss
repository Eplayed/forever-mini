/* 与中英速查页同一套控件（.search / .chips / .chip / .fav-btn / .fav），
   小程序的页面样式是各自隔离的，所以这里重复一份定义而不是跨页 @import；
   改视觉时两页要一起改，别只改一边。徽标继续用 app.wxss 的 .badge-L0…L3。 */

.search {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  color: var(--txt);
  font-size: 26rpx;
}

.fav-btn {
  margin-left: 14rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--txt-dim);
}

.fav-btn-on {
  color: var(--gold);
  border-color: var(--gold);
}

.chips {
  white-space: nowrap;
  margin-bottom: 14rpx;
}



.chip-src {
  border-style: dashed;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.mini-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.mini-row:last-child {
  border-bottom: 0;
}

.mini-name {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.mini-sub {
  margin-left: 16rpx;
}

.drow {
  display: flex;
  align-items: flex-start;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
}

.drow-art {
  margin-right: 14rpx;
  flex-shrink: 0;
}

.drow-main {
  flex: 1;
  min-width: 0;
}

.drow-side {
  width: 150rpx;
  text-align: right;
  margin-left: 12rpx;
}

.drow-title {
  font-size: 30rpx;
  font-weight: 600;
}

.drow-en {
  font-size: 24rpx;
  margin-top: 2rpx;
}

.drow-nameen {
  color: var(--blue);
}

.conflict {
  display: block;
  color: var(--warn);
  font-size: 22rpx;
}

.drow-meta {
  margin-top: 10rpx;
}

.tag {
  display: inline-block;
  margin: 0 10rpx 8rpx 0;
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.tag-zone {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

.drow-sub {
  margin-top: 4rpx;
}

.todo {
  color: var(--lead);
  font-size: 22rpx;
  margin-left: 10rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 10rpx;
}

.fav {
  width: 56rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--txt-dim);
  margin-top: 8rpx;
  margin-left: auto;
}

.fav-active {
  color: var(--gold);
}


.empty {
  text-align: center;
}

/* —— 页面底图两层（2026-10-23 站主：三个 tab 页共用官方天裔那张，top 居中）——
   图锚在页面顶部、按屏宽铺满高度按比例走（widthFix），跟着页面一起滚——
   钉在屏幕中间会把中段内容压在亮的云图上读不清（2026-10-23 实拍发现的），
   .fg 把所有内容浮到这两层上面。图取不到时这两层整个不渲染，就是原来的纯色版式。 */
.pagebg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: auto;
  z-index: 0;
}

.pagebg-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: var(--scrim-page);
}

/* 内容层必须自己抬一层：非定位元素会被 z-index:0 的定位层（图与暗底）盖住——
   只给 .wrap 加 z-index 没用，那抬的是整页相对页面根，不是相对它自己的两个孩子。
   2026-10-23 实拍就是这么发现的：名单全被暗底糊住了。 */
/* 底图两层是 absolute，锚在这一层顶上 */
.wrap {
  position: relative;
}

.fg {
  position: relative;
  z-index: 1;
}
