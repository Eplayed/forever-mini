/* 与中英速查页同一套控件（.search / .chips / .chip / .fav-btn / .fav），
   小程序的页面样式是各自隔离的，所以这里重复一份定义而不是跨页 @import；
   改视觉时两页要一起改，别只改一边。徽标继续用 app.wxss 的 .badge-L0…L3。 */

.search {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 搜索框是原生 <input>：真机上它由原生层绘制，backdrop-filter 与渐变层都不会作用在它身上，
   所以这里只给一层面色玻璃（跟上一版一样），不冒充"玻璃效果已加"。 */
.search-input {
  flex: 1;
  min-width: 0;
  background: var(--panel-glass);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  color: var(--txt);
  font-size: 26rpx;
}

.fav-btn {
  flex-shrink: 0;
  background: var(--panel-glass);
  margin-left: 14rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--txt-dim);
}

.fav-btn-on {
  color: var(--gold);
  border-color: var(--gold);
}

.chips {
  white-space: nowrap;
  margin-bottom: 14rpx;
}

.chips .chip:not(.chip-on) {
  background: var(--panel-glass);
}

.chip-src {
  border-style: dashed;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.mini-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.mini-row:last-child {
  border-bottom: 0;
}

.mini-name {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.mini-sub {
  margin-left: 16rpx;
}

/* 封面和信息分层，窄屏不让收藏按钮占标题宽度。 */
.dgrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.drow {
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--glass-sheen), var(--panel-glass);
  border: 1rpx solid var(--gold-line);
  border-radius: 8rpx;
}

.drow-pressed { border-color: var(--gold-hi); }

.drow-cover {
  position: relative;
  height: 150rpx;
  background: var(--panel);
}

.drow-cover-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, var(--scrim-card), transparent 70%);
  pointer-events: none;
}

.drow-kind {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 2rpx 10rpx;
  background: var(--scrim-card-b);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  color: var(--gold-hi);
  font-size: 20rpx;
}

.fav {
  position: absolute;
  right: 0;
  top: 0;
  width: 86rpx;
  height: 86rpx;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  box-sizing: border-box;
  padding: 10rpx 12rpx;
  color: var(--txt-title);
  font-size: 32rpx;
}

.fav-active { color: var(--gold-hot); }

.drow-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 13rpx 14rpx 15rpx;
  border-top: 1rpx solid var(--line);
}

.drow-title {
  color: var(--txt-title);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.drow-en {
  color: var(--txt-dim);
  font-size: 21rpx;
  line-height: 1.28;
  margin-top: 5rpx;
  overflow-wrap: anywhere;
}

.drow-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 12rpx;
  margin-top: auto;
  padding-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.drow-level { color: var(--gold-hi); font-weight: 650; }
.drow-faction { color: var(--txt-dim); }

.drow-zone {
  margin-top: 5rpx;
  color: var(--txt-muted);
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty {
  text-align: center;
}

/* —— 页面底图两层（2026-10-23 站主：三个 tab 页共用官方天裔那张，top 居中）——
   图锚在页面顶部、按屏宽铺满高度按比例走（widthFix），跟着页面一起滚——
   钉在屏幕中间会把中段内容压在亮的云图上读不清（2026-10-23 实拍发现的），
   .fg 把所有内容浮到这两层上面。图取不到时这两层整个不渲染，就是原来的纯色版式。 */
.pagebg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: auto;
  z-index: 0;
}

.pagebg-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 704rpx;
  pointer-events: none;
  z-index: 0;
  background: var(--scrim-page);
}

/* 内容层必须自己抬一层：非定位元素会被 z-index:0 的定位层（图与暗底）盖住——
   只给 .wrap 加 z-index 没用，那抬的是整页相对页面根，不是相对它自己的两个孩子。
   2026-10-23 实拍就是这么发现的：名单全被暗底糊住了。 */
/* 底图两层是 absolute，锚在这一层顶上 */
.wrap {
  position: relative;
}

.fg {
  position: relative;
  z-index: 1;
}

/* 卡片改成"玻璃底"（2026-10-23 站主：三页的卡片都加一些透明度；2026-10-24 二次指令：
   要更像玻璃，让页面背景更容易看到）：全局 .card 是纯色，这里只在这几页覆盖成
   高光与半透明面色；详情页/装备页没铺底图，仍用纯色那一份，不受影响。 */
.card {
  background: var(--glass-sheen), var(--panel-glass);
}
