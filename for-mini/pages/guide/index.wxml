<view class="wrap">
  <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
    请更新小程序以查看最新资料。
  </view>
  <view wx:elif="{{offline}}" class="notice">
    现在没连上线，指南要联网取。
  </view>

  <view class="lead plate">
    <view class="lead-t">指南</view>
  </view>

  <view wx:if="{{!loaded}}" class="card muted">正在取指南…</view>

  <block wx:if="{{loaded}}">
    <view wx:if="{{!macros.length && !addons.length}}" class="card empty">
      <view>暂无指南内容。</view>
    </view>

    <view wx:if="{{macros.length}}" class="sec">
      <view class="sec-t">宏命令</view>
      <view class="gcard" wx:for="{{macros}}" wx:key="id">
        <view class="gname">{{item.name}}</view>
        <view wx:if="{{item.use}}" class="muted guse">{{item.use}}</view>
        <view class="gtext">{{item.text}}</view>
        <view class="row gactions">
          <view class="btn" data-id="{{item.id}}" catchtap="onCopyMacro">复制宏文本</view>
          <view class="spacer"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{addons.length}}" class="sec">
      <view class="sec-t">插件名单</view>
      <view class="gcard" wx:for="{{addons}}" wx:key="id">
        <view class="gname">{{item.name}}<text class="muted gauthor">　{{item.author}}</text></view>
        <view wx:if="{{item.use}}" class="muted guse">{{item.use}}</view>
        <view class="row gactions">
          <view class="btn" data-url="{{item.url}}" catchtap="onCopyUrl">复制原帖地址</view>
          <view class="spacer"></view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{errorText}}" class="notice notice-bad">指南加载失败，请稍后再试。</view>
  <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
</view>
