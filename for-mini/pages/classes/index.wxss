/* 职业 tab（M03）。颜色一律走 app.wxss 令牌，页面里不写裸色值。 */

.lead {
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}

.lead-t {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--txt-title);
}

.lead-s {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--txt-muted);
}

.sec {
  margin-top: 26rpx;
}

.sec-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-hi);
  margin-bottom: 12rpx;
}

/* 组合卡：一排三个，图标在上、整名在下（2026-10-22 站主指令）。
   与首页职业格同一套思路——flex 换行，不做横向滚动 */
.combo3 {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.cmb {
  flex: 0 0 33.333%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 6rpx;
  margin-bottom: 12rpx;
}

.cmb-t {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
  text-align: center;
}

.race {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.race-open {
  border-color: var(--gold-line);
}

.race-head {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
}

.race-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.race-name {
  font-size: 27rpx;
  color: var(--txt);
}

.race-sub {
  margin-left: 10rpx;
  padding: 1rpx 8rpx;
  border: 1rpx dashed var(--line-2);
  border-radius: 4rpx;
  font-size: 19rpx;
  color: var(--txt-hint);
}

.race-meta {
  margin-top: 2rpx;
  font-size: 21rpx;
}

.race-go {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--gold);
}

.race-body {
  padding: 4rpx 16rpx 16rpx;
  border-top: 1rpx solid var(--line);
  background: var(--panel-2);
}

.pick {
  margin-top: 12rpx;
}

.pick-t {
  font-size: 21rpx;
  color: var(--txt-dim);
  margin-bottom: 8rpx;
}

.pick-row {
  display: flex;
  flex-wrap: wrap;
}

.pick-row .chip {
  margin: 0 10rpx 10rpx 0;
}

.trait {
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.trait:last-child {
  border-bottom: 0;
}

.trait-name {
  font-size: 24rpx;
  color: var(--txt);
}

.trait-passive {
  margin-left: 10rpx;
  font-size: 19rpx;
}

.trait-eff {
  margin-top: 2rpx;
  font-size: 21rpx;
  line-height: 1.5;
}
