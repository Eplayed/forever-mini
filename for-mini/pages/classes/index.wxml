<view class="wrap">
  <image wx:if="{{bgUrl}}" class="pagebg" src="{{bgUrl}}" mode="widthFix" binderror="onBgError" />
  <view wx:if="{{bgUrl}}" class="pagebg-scrim"></view>
  <view class="fg">

  <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
    请更新小程序以查看最新资料。
  </view>
  <view wx:elif="{{offline}}" class="notice">
    当前离线，天赋树需联网查看。
  </view>

  <view class="lead plate">
    <view class="lead-t">职业</view>
    <view class="lead-s">查看技能、天赋和可选种族。</view>
  </view>

  <view class="card chooser-card" bindtap="onOpenChooser">
    <view class="cc-main">
      <view class="cc-t">不知道玩什么职业？</view>
      <view class="cc-s">按你的玩法偏好选职业。</view>
    </view>
    <view class="cc-go">›</view>
  </view>

  <view class="card chooser-card" bindtap="onOpenCensus" aria-role="button" aria-label="查看人口普查">
    <view class="cc-main">
      <view class="cc-t">人口普查</view>
      <view class="cc-s">查看阵营比例与职业分布。</view>
    </view>
    <view class="cc-go">›</view>
  </view>

  <view wx:if="{{!loaded}}" class="card muted">正在取职业与种族名单…</view>

  <!-- 职业格：与首页同一份版式（一排五个、超出往下排、不做横向滚动），点一格进这个职业 -->
  <view class="cls9">
    <view class="cls" wx:for="{{classes}}" wx:key="classId" data-id="{{item.classId}}" bindtap="onPickClass">
      <icon-cell src="{{item.iconUrl}}" size="cls" label="{{item.nameCn}}" />
      <view class="cls-name">{{item.nameCn || '待核'}}</view>
    </view>
  </view>

  <!-- 无限新增的组合：一排三个，图标在上、整名在下（2026-10-22 站主指令）。
       2026-10-23 二次指令：格子里放的是**种族**图标（这一格新在哪个种族一眼看得出来），
       点进去仍是那个职业的天赋页。 -->
  <view wx:if="{{combos.length}}" class="sec">
    <view class="sec-t">无限新增的组合</view>
    <view class="combo3">
      <view class="cmb" wx:for="{{combos}}" wx:key="label" data-id="{{item.classId}}" data-race="{{item.raceId}}" bindtap="onPickCombo">
        <icon-cell src="{{item.iconUrl}}" size="cls" label="{{item.label}}" />
        <view class="cmb-t">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 种族：按阵营分两框（与职业详情同一套版式），框内一格＝图标在上、名字在下，一行三个往下排；
       框里不写"联盟/部落"那两个字，阵营由框体颜色说。点一格把这一族的详情铺在两框下面整宽显示。 -->
  <view class="sec">
    <view class="sec-t">种族</view>
    <view class="fac2">
      <view class="fac fac-alliance">
        <view class="fcell" wx:for="{{allianceRaces}}" wx:key="id" data-id="{{item.id}}" bindtap="onRaceToggle">
          <icon-cell src="{{item.iconUrl}}" size="sm" label="{{item.nameCn}}" />
          <view class="fname">{{item.nameCn}}</view>
        </view>
        <view class="fcell fcell-empty" wx:for="{{padAlliance}}" wx:key="*this"></view>
      </view>
      <view class="fac fac-horde">
        <view class="fcell" wx:for="{{hordeRaces}}" wx:key="id" data-id="{{item.id}}" bindtap="onRaceToggle">
          <icon-cell src="{{item.iconUrl}}" size="sm" label="{{item.nameCn}}" />
          <view class="fname">{{item.nameCn}}</view>
        </view>
        <view class="fcell fcell-empty" wx:for="{{padHorde}}" wx:key="*this"></view>
      </view>
    </view>
    <view wx:if="{{!picked}}" class="muted race-hint">点一个种族，看它能练哪些职业与它的种族特长。</view>

    <view wx:if="{{picked}}" class="card race-body">
      <view class="rb-head">
        <icon-cell src="{{picked.iconUrl}}" size="md" label="{{picked.nameCn}}" />
        <view class="race-main">
          <view class="race-name">{{picked.nameCn}}<text wx:if="{{picked.subgroup}}" class="race-sub">{{picked.subgroup}}</text></view>
          <view class="muted race-meta">{{picked.factionText}}</view>
        </view>
        <view class="muted rb-close" bindtap="onRaceToggle" data-id="{{picked.id}}">收起</view>
      </view>
      <view class="pick">
        <view class="pick-t">可选职业</view>
        <view class="pick-row">
          <view class="chip" wx:for="{{picked.classList}}" wx:for-item="cc" wx:key="classId" data-id="{{cc.classId}}" catchtap="onPickClass">{{cc.nameCn}}</view>
        </view>
      </view>
      <view wx:if="{{picked.traits.length}}" class="pick">
        <view class="pick-t">种族特长</view>
        <view class="trait" wx:for="{{picked.traits}}" wx:key="name">
          <view class="trait-name">{{item.name}}<text wx:if="{{item.passive}}" class="muted trait-passive">被动</text></view>
          <view class="muted trait-eff">{{item.effect}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="notice notice-bad">职业资料加载失败，请稍后再试。</view>
  <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
  </view>
</view>

