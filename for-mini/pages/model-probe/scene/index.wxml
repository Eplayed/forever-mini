<xr-scene id="xr-scene" bind:ready="handleReady" bind:error="handleSceneError">
  <xr-assets bind:progress="handleProgress" bind:loaded="handleLoaded" bind:error="handleAssetError">
    <xr-asset-load type="gltf" asset-id="hero" src="{{src}}" />
  </xr-assets>
  <xr-node>
    <xr-node node-id="camera-target" position="0 1 0"></xr-node>
    <xr-gltf id="hero" node-id="hero" position="0 0 0" rotation="0 0 0" scale="1 1 1" model="hero"></xr-gltf>
    <xr-camera id="camera" node-id="camera" position="0 1.2 2.4" near="0.1" far="200" target="camera-target"
               clear-color="0.05 0.07 0.11 1" camera-orbit-control=""></xr-camera>
  </xr-node>
  <xr-node node-id="lights">
    <xr-light type="ambient" color="1 1 1" intensity="0.75" />
    <xr-light type="directional" rotation="30 120 0" color="1 1 1" intensity="2.2" />
  </xr-node>
</xr-scene>
