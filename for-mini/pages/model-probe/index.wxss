/* 临时探针页样式：只吃 app.wxss 的令牌，不写裸色值（全站一条规矩，探针页也一样）。 */

.probe {
  min-height: 100vh;
  background: var(--bg);
  padding: 16rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.bar {
  padding: 12rpx 0 16rpx;
}

.st {
  font-size: 28rpx;
  font-weight: 600;
}

.st-loading {
  color: var(--txt-dim);
}

.st-ok {
  color: var(--ok);
}

.st-partial {
  color: var(--warn);
}

.st-bad {
  color: var(--txt-alert);
}

.meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--txt-hint);
  line-height: 1.5;
}

/* 场景容器：xr-scene 由组件铺满这一格 */
.stage {
  position: relative;
  display: block;
  width: 100%;
  height: 620rpx;
  overflow: hidden;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}

.row {
  display: flex;
  margin-top: 18rpx;
}

.btn {
  flex: 1;
  margin-right: 12rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--gold-hi);
  border: 1rpx solid var(--gold);
  border-radius: var(--r-ctl);
}

.btn:last-child {
  margin-right: 0;
}

.hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--txt-hint);
}

.box {
  margin-top: 20rpx;
  padding: 18rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}

.box-t {
  font-size: 24rpx;
  color: var(--gold);
  margin-bottom: 8rpx;
}

.box-t-bad {
  color: var(--txt-alert);
}

.line {
  font-size: 22rpx;
  color: var(--txt-dim);
  line-height: 1.6;
  word-break: break-all;
}

.line-err {
  color: var(--txt-alert);
  font-size: 20rpx;
}

.btn-on {
  color: var(--accent-ink);
  background: var(--gold-hot);
  border-color: var(--gold-hot);
}
