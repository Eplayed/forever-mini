<view class="wrap">
  <view wx:if="{{!loaded}}" class="card muted pad">正在取问卷…</view>

  <block wx:elif="{{errorText}}">
    <view class="card empty">
      <view class="muted">{{errorText}}</view>
      <view class="btn gold retry" bindtap="onRetry">再试一次</view>
    </view>
  </block>

  <block wx:else>
    <view class="head">
      <view class="head-t">不知道玩什么职业？</view>
      <view class="head-s">答 {{total}} 道题，按你的玩法口味给个参考。</view>
    </view>
    <view wx:if="{{note}}" class="muted note">{{note}}</view>
    <view wx:if="{{offline}}" class="muted note">当前离线，显示已保存的问卷。</view>

    <block wx:if="{{!finished}}">
      <view class="prog">
        <view class="prog-in" style="width: {{total ? (step / total) * 100 : 0}}%"></view>
      </view>
      <view class="prog-t">{{step + 1}} / {{total}}</view>

      <view class="card qcard" wx:if="{{q}}">
        <view class="q-t">{{q.q}}</view>
        <view wx:if="{{q.hint}}" class="muted q-hint">{{q.hint}}</view>
        <view
          wx:for="{{q.options}}"
          wx:key="id"
          class="opt {{picked === item.id ? 'opt-on' : ''}}"
          data-oid="{{item.id}}"
          bindtap="onPick">
          <view class="opt-l">{{item.label}}</view>
          <view wx:if="{{item.note}}" class="opt-n">{{item.note}}</view>
        </view>
        <view wx:if="{{step > 0}}" class="linkback" data-step="{{step - 1}}" bindtap="onBack">上一题</view>
      </view>
    </block>

    <block wx:else>
      <view class="card rcard">
        <view class="card-title">按你的答法，先看这几个</view>
        <view wx:if="{{tieNote}}" class="muted tie">{{tieNote}}</view>
        <view
          wx:for="{{results}}"
          wx:key="id"
          class="rrow {{item.first ? 'rrow-first' : ''}}"
          data-id="{{item.id}}"
          bindtap="onOpenClass">
          <view class="r-name">
            <text>{{item.name}}</text>
            <text wx:if="{{item.tie}}" class="r-tie">并列</text>
            <text wx:if="{{item.first}}" class="r-go">看它的天赋与技能</text>
          </view>
          <view class="r-bar">
            <view class="r-bar-in" style="width: {{item.pct}}%"></view>
          </view>
        </view>
        <view class="muted r-note">结果反映你的玩法偏好。点职业可查看天赋和技能。</view>
      </view>
      <view class="btn gold restart" bindtap="onRestart">重新答一次</view>
    </block>

    <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
  </block>
</view>
