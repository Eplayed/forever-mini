.census-head {
  border-color: var(--gold-line);
}

.census-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.census-tabs .census-action {
  flex: 1;
  margin: 0;
}

.census-tabs .census-tab-on {
  color: var(--accent-ink);
  background: var(--gold-hot);
}

.census-title {
  color: var(--txt-title);
  font-size: 44rpx;
  font-weight: 700;
  margin: 6rpx 0 14rpx;
}

.census-kicker {
  color: var(--gold-hi);
  font-size: 22rpx;
}

.sample-total {
  color: var(--txt-title);
  font-size: 42rpx;
  font-weight: 700;
  margin: 10rpx 0 6rpx;
}

.sample-unit, .census-meta, .census-note, .class-count {
  font-size: 22rpx;
  font-weight: 400;
}

.census-meta {
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.census-note {
  margin-top: 10rpx;
  line-height: 1.55;
}

.census-section {
  color: var(--txt-title);
  font-size: 30rpx;
  font-weight: 700;
}

.faction-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.faction-cell {
  flex: 1;
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid;
  border-radius: var(--r-ctl);
}

.faction-alliance {
  border-color: var(--fac-alliance-line);
  background: var(--fac-alliance-bg);
}

.faction-horde {
  border-color: var(--fac-horde-line);
  background: var(--fac-horde-bg);
}

.faction-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 2rpx 8rpx;
}

.faction-name { font-size: 24rpx; }
.faction-value { color: var(--txt-title); font-size: 30rpx; font-weight: 700; }

.class-row {
  margin-top: 18rpx;
}

.class-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  font-size: 24rpx;
}

.class-value {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  color: var(--gold-hi);
}

.census-progress { margin-top: 7rpx; }

.census-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.census-action {
  width: auto;
  margin: 12rpx 0 0;
  padding: 4rpx 14rpx;
  min-height: 54rpx;
  line-height: 46rpx;
  font-size: 22rpx;
}
