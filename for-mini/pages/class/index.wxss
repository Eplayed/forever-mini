/* 职业详情（M03）。颜色走 app.wxss 令牌。 */

.head {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}

.head-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.head-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--txt-title);
}

.head-en {
  margin-top: 2rpx;
  font-size: 21rpx;
}

.btn-share {
  flex-shrink: 0;
  margin-left: 10rpx;
  border-style: dashed;
  background: transparent;
}

.sec {
  margin-bottom: 24rpx;
}

.sec-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-hi);
  margin-bottom: 12rpx;
}

.race-row {
  display: flex;
  align-items: center;
  padding: 10rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.race-row:last-child {
  border-bottom: 0;
}

.race-name {
  margin-left: 12rpx;
  font-size: 25rpx;
  color: var(--txt);
}

.race-sub {
  margin-left: 10rpx;
  padding: 1rpx 8rpx;
  border: 1rpx dashed var(--line-2);
  border-radius: 4rpx;
  font-size: 18rpx;
  color: var(--txt-hint);
}

.race-fac {
  margin-left: auto;
  font-size: 21rpx;
}

.btn.gold {
  background: transparent;
  color: var(--gold);
  border-color: var(--gold);
}

.chips {
  white-space: nowrap;
  margin-bottom: 14rpx;
}

.tree {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx;
}

.trow {
  display: flex;
  margin-bottom: 14rpx;
}

.trow:last-child {
  margin-bottom: 0;
}

.tcell {
  width: 25%;
  box-sizing: border-box;
  padding: 0 6rpx;
  text-align: center;
}

.tcell-empty {
  visibility: hidden;
}

.tname {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.35;
  color: var(--txt);
  overflow: hidden;
}

.trank {
  font-size: 18rpx;
}

.tcell-miss .tname {
  color: var(--txt-caution);
}

.tree-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.55;
}
