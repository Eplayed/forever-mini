/* 职业详情（M03）。颜色走 app.wxss 令牌。 */

.head {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}

.head-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.head-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--txt-title);
}

.head-en {
  margin-top: 2rpx;
  font-size: 21rpx;
}

/* 工具条里那个是 <button open-type="share">——button 有自己的默认内边距与行高，
   不重置就会和旁边的 view 按钮高低不齐（微信里"分享"必须是 button，view 触发不了） */
.btn-share {
  flex-shrink: 0;
  height: auto;
  margin: 0 12rpx 0 0;
  padding: 10rpx 24rpx;
  line-height: 1.4;
  font-size: 24rpx;
  border: 1rpx solid var(--gold);
  border-radius: var(--r-ctl);
  color: var(--gold-hi);
  background: transparent;
}

.btn-share::after {
  border: 0;
}

.sec {
  margin-bottom: 24rpx;
}

.sec-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-hi);
  margin-bottom: 12rpx;
}

/* —— 可选种族：联盟 / 部落左右两框（2026-10-22 站主指令）——
   框体背景与描边吃阵营色令牌，框内一格＝图标在上、名字在下，一行三个、多的往下排。
   框里不写"联盟/部落"：颜色与左右位置就是那件事。 */
.fac2 {
  display: flex;
  align-items: stretch;
}

.fac {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 6rpx 2rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}

.fac-alliance {
  margin-right: 12rpx;
  background: var(--fac-alliance-bg);
  border-color: var(--fac-alliance-line);
}

.fac-horde {
  background: var(--fac-horde-bg);
  border-color: var(--fac-horde-line);
}

.fcell {
  flex: 0 0 33.333%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 2rpx 12rpx;
}

.fname {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.3;
  text-align: center;
  color: var(--txt);
}

/* 补到 3 的倍数用的空位：占位不显示，但保证最后一行不半格错位 */
.fcell-empty {
  visibility: hidden;
}

.btn.gold {
  background: transparent;
  color: var(--gold);
  border-color: var(--gold);
}

/* —— 模拟器读数条 —— */
.tbar {
  display: flex;
  align-items: center;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  padding: 14rpx 18rpx;
}

.tbar-left {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.tnum {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--gold-hi);
  font-family: Menlo, Consolas, monospace;
}

.tunit {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.tbar-right {
  display: flex;
}

.tbar-right .btn {
  margin-left: 12rpx;
}

.tsum {
  margin: 8rpx 2rpx 12rpx;
  font-size: 21rpx;
}

/* 三系切换：三格平铺，不用 scroll-view（三个名字放得下，横滚反而像还能滑出第四个） */
.tabs {
  display: flex;
  margin-bottom: 12rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  margin-right: 10rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
  font-size: 24rpx;
  color: var(--txt-dim);
}

.tab:last-child {
  margin-right: 0;
}

.tab-on {
  background: var(--gold-glow);
  border-color: var(--gold);
  color: var(--gold-hi);
}

.tab-n {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: var(--txt-muted);
}

.tab-on .tab-n {
  color: var(--gold-hi);
}

/* —— 天赋格 ——
   四列一行（与客户端那张树同宽），状态四通道区分：
   已点=金边抬起、点满=金实心、现在不能点=压暗、名字没核到=警示色。不只看颜色也看边框 */
/* 系底图（与网页同一张 specs/{职业}-{系序号}）：图 + 由上往下的暗渐变，
   压暗是为了格子上的名字读得清；取不到图就是原来的纯色面板。 */
.tree {
  position: relative;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  padding: 14rpx 10rpx;
}

.tree-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.tree-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(180deg, var(--scrim-card) 0%, var(--scrim-card-b) 100%);
}

.trow,
.tcell {
  position: relative;
  z-index: 1;
}

.trow {
  display: flex;
  margin-bottom: 14rpx;
}

.trow:last-child {
  margin-bottom: 0;
}

.tcell {
  width: 25%;
  box-sizing: border-box;
  padding: 6rpx;
  text-align: center;
  border: 1rpx solid transparent;
  border-radius: var(--r-ctl);
}

.tkick {
  position: relative;
  display: inline-block;
}

.trank {
  position: absolute;
  right: -6rpx;
  bottom: -4rpx;
  min-width: 34rpx;
  padding: 0 6rpx;
  background: var(--sunk);
  border: 1rpx solid var(--gold-line);
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--gold-hi);
  font-family: Menlo, Consolas, monospace;
}

.tcell-empty {
  visibility: hidden;
}

.tname {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.35;
  color: var(--txt);
  overflow: hidden;
}

.tcell-on {
  border-color: var(--gold-line);
  background: var(--panel-2);
}

.tcell-full {
  border-color: var(--gold);
  background: var(--gold-glow);
}

/* 现在点不了的：整格压暗。仍然可点长按看"为什么点不了"，所以不隐藏、不 disabled */
.tcell-off {
  opacity: 0.42;
}

.tcell-miss .tname {
  color: var(--txt-caution);
}

.tree-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.55;
}

/* —— 天赋详情面板：与页面同一套令牌，不用系统对话框（系统框吃不到暗色主题）—— */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--scrim-pop);
  z-index: 20;
}

.pop {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 40rpx;
  z-index: 21;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  padding: 22rpx 22rpx 18rpx;
  box-shadow: 0 12rpx 40rpx var(--foot);
}

.pop-head {
  display: flex;
  align-items: center;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--gold-line-soft);
}

.pop-title {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.pop-name {
  font-size: 28rpx;
  color: var(--txt-title);
}

.pop-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
}

.pop-x {
  font-size: 21rpx;
  color: var(--txt-muted);
  padding: 6rpx 4rpx 6rpx 16rpx;
}

.pop-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 23rpx;
}

.pop-k {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--txt-muted);
}

.pop-v {
  flex: 1;
  color: var(--txt);
}

.pop-why {
  color: var(--txt-caution);
}

.pop-alt-note {
  font-size: 19rpx;
}

/* 库里没有的那句照实说：这一段用警示色左边条标出来，别让它长得像一条已核到的说明 */
.pop-desc {
  display: flex;
  padding: 12rpx 0 12rpx 14rpx;
  border-left: 4rpx solid var(--warn);
  border-bottom: 1rpx solid var(--line);
  font-size: 21rpx;
}

.pop-desc .pop-k {
  color: var(--txt-caution);
}

.pop-desc-v {
  flex: 1;
  line-height: 1.55;
}

.pop-btns {
  display: flex;
  margin-top: 16rpx;
}

.pop-btns .btn {
  flex: 1;
  text-align: center;
  margin-right: 12rpx;
}

.pop-btns .btn:last-child {
  margin-right: 0;
}

.btn-dim {
  opacity: 0.4;
}

.pop-note {
  margin-top: 12rpx;
  font-size: 19rpx;
  line-height: 1.5;
}
