<view class="wrap home">
  <view class="masthead">
    <view class="mast-name">跑本助手</view>
    <text class="mast-tag">无限服</text>
  </view>

  <view wx:if="{{requiresUpdate}}" class="notice notice-bad">请更新小程序后查看完整内容。</view>
  <view wx:elif="{{offline}}" class="notice">离线浏览 · 部分内容需联网</view>
  <view wx:if="{{cd}}" class="launch">
    <text wx:if="{{cd.today}}">今天开服</text>
    <text wx:else>距开服 {{cd.d}} 天</text>
    <text>{{cd.dayText}}</text>
  </view>
  <view wx:elif="{{raidBanner}}" class="raid-banner">
    <view class="raid-banner-top" aria-role="button" bindtap="goRaids" hover-class="entry-pressed">
      <view class="raid-banner-title">
        <text class="raid-tag">12月10日首开</text>
        <text class="raid-name">{{raidBanner.headline}}</text>
      </view>
      <text class="raid-arrow" aria-hidden="true">›</text>
    </view>
    <view class="raid-banner-sub">深穴 10人 · 海加尔峰 20人 · 奥妮克希亚 40人（每周重置）</view>
    <view class="raid-banner-btns">
      <view class="raid-chip" aria-role="button" bindtap="goRaids" hover-class="entry-pressed">3 座团本 ›</view>
      <view class="raid-chip raid-chip-warn" aria-role="button" bindtap="goOnyxia" hover-class="entry-pressed">黑龙门任务打卡 ›</view>
      <view class="raid-chip" aria-role="button" bindtap="goBis60" hover-class="entry-pressed">60级团前/T1 ›</view>
    </view>
  </view>

  <view class="adventure-card">
    <view class="adventure-main" aria-role="button" bindtap="goAdventure" hover-class="entry-pressed">
      <image class="adventure-book" src="/img/home/adventure-book.jpg" mode="aspectFill" aria-hidden="true" />
      <view class="adventure-copy">
        <view class="adventure-title">我的冒险清单</view>
        <view class="adventure-detail">{{adventurePending ? adventurePending + ' 件想要的装备' : '安排下次跑本与装备目标'}}</view>
      </view>
      <text class="adventure-arrow" aria-hidden="true">›</text>
    </view>
    <view wx:if="{{adventureNext}}" class="adventure-continue" aria-role="button" data-id="{{adventureNext.id}}" bindtap="continueAdventure" hover-class="entry-pressed">
      <text>{{adventurePlanned ? '首选副本' : '继续上次副本'}}</text><text class="adventure-dungeon">{{adventureNext.name || adventureNext.title}} ›</text>
    </view>
  </view>

  <swiper class="spotlight" current="{{featuredIndex}}" duration="0" bindchange="onFeaturedChange">
    <swiper-item>
      <view class="feature feature-dungeons {{featuredIndex === 0 ? 'feature-selected' : ''}}" aria-role="button" bindtap="goDungeons">
        <image wx:if="{{cardBg.dungeons}}" class="feature-art" src="{{cardBg.dungeons}}" mode="aspectFill" data-k="dungeons" binderror="onArtError" />
        <view class="feature-scrim"></view>
        <view class="feature-body">
          <view class="feature-title">副本手册</view>
          <view class="feature-desc">路线 · 首领掉落 · 任务坐标</view>
          <view class="feature-cta">打开手册 <text aria-hidden="true">›</text></view>
        </view>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="feature feature-census {{featuredIndex === 1 ? 'feature-selected' : ''}}" aria-role="button" bindtap="goCensus">
        <image wx:if="{{bgUrl}}" class="feature-art" src="{{bgUrl}}" mode="aspectFill" data-k="bg" binderror="onArtError" />
        <view class="feature-scrim"></view>
        <view class="feature-body">
          <view class="feature-title">人口普查</view>
          <view class="feature-desc">阵营比例与职业分布</view>
          <view class="feature-cta">查看普查 <text aria-hidden="true">›</text></view>
        </view>
      </view>
    </swiper-item>
  </swiper>
  <view class="feature-tabs">
    <button class="feature-tab {{featuredIndex === 0 ? 'feature-tab-on' : ''}}" data-index="0" bindtap="onFeaturedSelect" hover-class="entry-pressed" aria-pressed="{{featuredIndex === 0}}">副本手册</button>
    <button class="feature-tab {{featuredIndex === 1 ? 'feature-tab-on' : ''}}" data-index="1" bindtap="onFeaturedSelect" hover-class="entry-pressed" aria-pressed="{{featuredIndex === 1}}">人口普查</button>
  </view>

  <view wx:if="{{openGRank}}" class="grank-card">
    <view class="grank-head">
      <view class="grank-title-wrap">
        <text class="grank-title">区服 G 排行</text>
        <text class="grank-unit">1米 ≈ xxG</text>
      </view>
      <text class="grank-time">{{gRankUpdated ? '更新 ' + gRankUpdated : '待更新'}}</text>
    </view>
    <view class="grank-tabs">
      <view class="grank-tab {{gRankFaction === 'all' ? 'grank-tab-on' : ''}}" data-faction="all" bindtap="onPickGRankFaction" aria-role="button">全部</view>
      <view class="grank-tab {{gRankFaction === 'alliance' ? 'grank-tab-on grank-tab-a' : ''}}" data-faction="alliance" bindtap="onPickGRankFaction" aria-role="button">联盟</view>
      <view class="grank-tab {{gRankFaction === 'horde' ? 'grank-tab-on grank-tab-h' : ''}}" data-faction="horde" bindtap="onPickGRankFaction" aria-role="button">部落</view>
    </view>
    <view wx:if="{{gRankView.length}}" class="grank-list">
      <view wx:for="{{gRankView}}" wx:key="id" class="grank-row">
        <view class="grank-pos {{item.rank <= 3 ? 'grank-pos-' + item.rank : ''}}">{{item.rank}}</view>
        <view class="grank-main">
          <text class="grank-realm">{{item.realm}}</text>
          <text class="grank-fac {{item.faction === 'alliance' ? 'grank-fac-a' : 'grank-fac-h'}}">{{item.factionText}}</text>
        </view>
        <view class="grank-val">
          <text class="grank-prefix">1米 ≈ </text>
          <text class="grank-num">{{item.rateText}}</text>
          <text class="grank-g"> G</text>
        </view>
      </view>
    </view>
    <view wx:else class="grank-empty">
      {{gRankLoaded ? (gRankHasAny ? '当前阵营暂无数据' : '暂未录入区服 G 数据，稍后更新') : '正在读取区服 G 排行…'}}
    </view>
    <view wx:if="{{gRankTotal > 5}}" class="grank-more" bindtap="onToggleGRankExpand" aria-role="button">
      {{gRankExpanded ? '收起排行 ▴' : '展开全部（共 ' + gRankTotal + ' 条）▾'}}
    </view>
    <view wx:if="{{gRankNote}}" class="grank-note">{{gRankNote}}</view>
  </view>

  <view class="sec-title">常用查询</view>
  <view class="grid priority">
    <view class="entry priority-entry priority-bis" aria-role="button" bindtap="goBis" hover-class="entry-pressed">
      <image wx:if="{{cardBg.bis}}" class="entry-art" src="{{cardBg.bis}}" mode="aspectFill" data-k="bis" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <image class="entry-emblem" src="/img/home/bis-icon.png" mode="aspectFit" aria-hidden="true" />
      <view class="entry-content">
        <view class="entry-name">BIS配装 <text class="entry-arrow" aria-hidden="true">›</text></view>
        <view class="entry-desc">30/60级 · T1与新套装</view>
      </view>
    </view>
    <view class="entry priority-entry" aria-role="button" bindtap="goLoots" hover-class="entry-pressed">
      <image wx:if="{{cardBg.loots}}" class="entry-art" src="{{cardBg.loots}}" mode="aspectFill" binderror="onArtError" data-k="loots" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-content">
        <view class="entry-name">掉落查询 <text class="entry-arrow" aria-hidden="true">›</text></view>
        <view class="entry-desc">按物品查掉落首领</view>
      </view>
    </view>
    <view wx:if="{{openMacros}}" class="entry priority-entry" aria-role="button" bindtap="goMacros" hover-class="entry-pressed">
      <image wx:if="{{cardBg.macros}}" class="entry-art" src="{{cardBg.macros}}" mode="aspectFill" data-k="macros" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-content">
        <view class="entry-name">宏命令<text class="entry-arrow" aria-hidden="true">›</text></view>
        <view class="entry-desc">按职业查找与复制</view>
      </view>
    </view>
    <view class="entry priority-entry leveling-entry" aria-role="button" bindtap="goLeveling" hover-class="entry-pressed">
      <view class="entry-content">
        <view class="entry-name">练级天赋 <text class="entry-arrow" aria-hidden="true">›</text></view>
        <view class="entry-desc">按职业选练级方案</view>
      </view>
    </view>
  </view>

  <view class="leveling-heading">
    <view class="sec-title">天赋速览</view>
    <view class="leveling-all" aria-role="button" bindtap="goLeveling">全部职业 ›</view>
  </view>
  <view class="leveling-cards">
    <view wx:for="{{leveling}}" wx:key="classId" class="leveling-card" aria-role="button" hover-class="entry-pressed"
          data-id="{{item.classId}}" bindtap="goLeveling">
      <icon-cell src="{{levelingIcons[item.classId] || ''}}" size="sm" label="{{item.className}}" />
      <text class="leveling-class">{{item.className}}</text>
      <text class="leveling-name">{{item.name}}</text>
      <text class="leveling-feature">{{item.feature}}</text>
    </view>
  </view>

  <view class="sec-title">更多工具</view>
  <view class="grid tools">
    <view wx:if="{{openProfessions}}" class="entry tool-entry" aria-role="button" bindtap="goProfessions" hover-class="entry-pressed">
      <image wx:if="{{cardBg.professions}}" class="entry-art" src="{{cardBg.professions}}" mode="aspectFill" data-k="professions" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-name">专业与配方 <text class="entry-arrow">›</text></view>
      <view class="entry-desc">技能等级与材料</view>
    </view>
    <view wx:if="{{openNamer}}" class="entry tool-entry" aria-role="button" bindtap="goNamer" hover-class="entry-pressed">
      <image wx:if="{{cardBg.namer}}" class="entry-art" src="{{cardBg.namer}}" mode="aspectFill" data-k="namer" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <image class="tool-icon" src="/img/home/namer-icon.png" mode="aspectFit" />
      <view class="entry-name">角色起名 <text class="entry-arrow">›</text></view>
      <view class="entry-desc">生成职业角色名</view>
    </view>
    <view class="entry tool-entry" aria-role="button" bindtap="goClasses" hover-class="entry-pressed">
      <image wx:if="{{cardBg.classes}}" class="entry-art" src="{{cardBg.classes}}" mode="aspectFill" data-k="classes" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-name">职业 <text class="entry-arrow" aria-hidden="true">›</text></view>
      <view class="entry-desc">技能书与天赋</view>
    </view>
  </view>

  <view class="sec-title">选择你的职业</view>
  <view wx:if="{{classes.length}}" class="cls9">
    <view class="cls {{activeClass === item.classId ? 'cls-on' : ''}}" wx:for="{{classes}}" wx:key="classId"
          data-id="{{item.classId}}" bindtap="onPickClass">
      <icon-cell src="{{item.iconUrl}}" size="cls" label="{{item.nameCn}}" />
      <view class="cls-name">{{item.nameCn}}</view>
    </view>
  </view>
  <view wx:else class="muted cls-empty">{{classEmpty}}</view>

  <!-- 4）选中职业的可选种族与种族特长：默认收起为一行标签，点职业或展开钮查看完整特长 -->
  <block wx:if="{{activeName}}">
    <view class="race-bar">
      <view class="sec-title race-title" bindtap="toggleRaces">{{activeName}} · 可选种族（{{races.length}}）<text class="race-toggle">{{racesExpanded ? '收起 ▴' : '展开特长 ▾'}}</text></view>
      <view class="race-go" bindtap="goClass">看技能书与天赋树 →</view>
    </view>
    <view wx:if="{{raceNote}}" class="muted race-none">{{raceNote}}</view>
    <view wx:if="{{!racesExpanded && races.length}}" class="race-chips" bindtap="toggleRaces">
      <text class="race-chip" wx:for="{{races}}" wx:key="key">{{item.nameCn}}{{item.subCn ? '·' + item.subCn : ''}}</text>
      <text class="race-chip-more">点此查看种族特长 ▾</text>
    </view>
    <block wx:if="{{racesExpanded}}">
      <view class="race plate" wx:for="{{races}}" wx:key="key">
        <view class="race-top">
          <!-- 缺图就让它显示首字块：88rpx 的格子里塞"没有这张图标"六个字会被裁成"没有这"，
               既难看又读不完（暗夜精灵那条实拍里就是这样） -->
          <icon-cell src="{{item.iconUrl}}" size="md" label="{{item.nameCn}}" />
          <view class="race-id">
            <view class="race-name">
              {{item.nameCn}}
              <text wx:if="{{item.nameMissing}}" class="todo">中文名待补</text>
            </view>
            <view class="race-fac">{{item.factionText}}<text wx:if="{{item.subCn}}" class="race-sub">{{item.subCn}}</text></view>
          </view>
        </view>
        <view wx:if="{{item.traits.length}}" class="traits">
          <view class="trait" wx:for="{{item.traits}}" wx:for-item="t" wx:key="key">
            <icon-cell src="{{t.iconUrl}}" size="sm" label="{{t.name}}" />
            <view class="trait-main">
              <view class="trait-name">
                {{t.name}}
                <text wx:if="{{t.passive}}" class="trait-pass">被动</text>
              </view>
              <view wx:if="{{t.effect}}" class="trait-eff">{{t.effect}}</view>
              <view wx:else class="muted trait-eff">效果还没核到</view>
            </view>
          </view>
        </view>
        <view wx:else class="muted trait-none">种族特长还没核到</view>
      </view>
    </block>
  </block>

  <block wx:if="{{recent.length}}">
    <view class="sec-title sec-title-2">最近查看</view>
    <scroll-view class="rail" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="mini plate" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecentTap">
        <view class="mini-name">{{item.title}}</view>
        <view class="mini-meta">
          <text class="mini-range">{{item.range}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <view class="foot">非官方粉丝资料站，与游戏开发及运营方无关。</view>
</view>
