<view class="wrap home">
  <view class="masthead">
    <view class="mast-name">跑本助手</view>
    <text class="mast-tag">无限服</text>
  </view>

  <view wx:if="{{requiresUpdate}}" class="notice notice-bad">请更新小程序后查看完整内容。</view>
  <view wx:elif="{{offline}}" class="notice">离线浏览 · 部分内容需联网</view>
  <view wx:if="{{cd}}" class="launch">
    <text wx:if="{{cd.today}}">今天开服</text>
    <text wx:else>距开服 {{cd.d}} 天</text>
    <text>{{cd.dayText}}</text>
  </view>

  <swiper class="spotlight" current="{{featuredIndex}}" duration="320" bindchange="onFeaturedChange">
    <swiper-item>
      <view class="feature feature-census" bindtap="goCensus">
        <image wx:if="{{bgUrl}}" class="feature-art" src="{{bgUrl}}" mode="aspectFill" data-k="bg" binderror="onArtError" />
        <view class="feature-scrim"></view>
        <view class="feature-body">
          <text class="feature-tag">无限服</text>
          <view class="feature-title">人口普查</view>
          <view class="feature-desc">阵营比例与职业分布</view>
          <view class="feature-cta">查看普查 <text>›</text></view>
        </view>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="feature feature-dungeons" bindtap="goDungeons">
        <image wx:if="{{cardBg.dungeons}}" class="feature-art" src="{{cardBg.dungeons}}" mode="aspectFill" data-k="dungeons" binderror="onArtError" />
        <view class="feature-scrim"></view>
        <view class="feature-body">
          <text class="feature-tag">五人副本</text>
          <view class="feature-title">副本手册</view>
          <view class="feature-desc">路线、首领掉落与任务坐标</view>
          <view class="feature-cta">查副本 <text>›</text></view>
        </view>
      </view>
    </swiper-item>
  </swiper>
  <view class="feature-tabs">
    <button class="feature-tab {{featuredIndex === 0 ? 'feature-tab-on' : ''}}" data-index="0" bindtap="onFeaturedSelect">人口普查</button>
    <button class="feature-tab {{featuredIndex === 1 ? 'feature-tab-on' : ''}}" data-index="1" bindtap="onFeaturedSelect">副本手册</button>
  </view>

  <view class="sec-title">常用查询</view>
  <view class="grid priority">
    <view class="entry priority-entry" bindtap="goLoots" hover-class="entry-pressed">
      <image wx:if="{{cardBg.loots}}" class="entry-art" src="{{cardBg.loots}}" mode="aspectFill" binderror="onArtError" data-k="loots" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-content">
        <view class="entry-name">掉落查询 <text class="entry-arrow">›</text></view>
        <view class="entry-desc">物品 · 掉落首领</view>
      </view>
    </view>
    <view class="entry priority-entry" bindtap="goBis" hover-class="entry-pressed">
      <image wx:if="{{cardBg.bis}}" class="entry-art" src="{{cardBg.bis}}" mode="aspectFill" data-k="bis" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <image class="entry-emblem" src="/img/home/bis-icon.png" mode="aspectFit" />
      <view class="entry-content">
        <view class="entry-name">BIS配装 <text class="entry-arrow">›</text></view>
        <view class="entry-desc">职业套装 · 部位备选</view>
      </view>
    </view>
  </view>

  <view class="sec-title">更多工具</view>
  <view class="grid tools">
    <view class="entry tool-entry" bindtap="goClasses" hover-class="entry-pressed">
      <image wx:if="{{cardBg.classes}}" class="entry-art" src="{{cardBg.classes}}" mode="aspectFill" data-k="classes" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-name">职业 <text class="entry-arrow">›</text></view>
      <view class="entry-desc">技能书与天赋</view>
    </view>
    <view wx:if="{{openMacros}}" class="entry tool-entry" bindtap="goMacros" hover-class="entry-pressed">
      <image wx:if="{{cardBg.macros}}" class="entry-art" src="{{cardBg.macros}}" mode="aspectFill" data-k="macros" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-name">宏命令 <text class="entry-arrow">›</text></view>
      <view class="entry-desc">按职业查找与复制</view>
    </view>
    <view wx:if="{{openProfessions}}" class="entry tool-entry" bindtap="goProfessions" hover-class="entry-pressed">
      <image wx:if="{{cardBg.professions}}" class="entry-art" src="{{cardBg.professions}}" mode="aspectFill" data-k="professions" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <view class="entry-name">专业与配方 <text class="entry-arrow">›</text></view>
      <view class="entry-desc">技能等级与材料</view>
    </view>
    <view wx:if="{{openNamer}}" class="entry tool-entry" bindtap="goNamer" hover-class="entry-pressed">
      <image wx:if="{{cardBg.namer}}" class="entry-art" src="{{cardBg.namer}}" mode="aspectFill" data-k="namer" binderror="onArtError" lazy-load />
      <view class="entry-scrim"></view>
      <image class="tool-icon" src="/img/home/namer-icon.png" mode="aspectFit" />
      <view class="entry-name">角色起名 <text class="entry-arrow">›</text></view>
      <view class="entry-desc">生成职业角色名</view>
    </view>
  </view>

  <view class="sec-title">选择你的职业</view>
  <view wx:if="{{classes.length}}" class="cls9">
    <view class="cls {{activeClass === item.classId ? 'cls-on' : ''}}" wx:for="{{classes}}" wx:key="classId"
          data-id="{{item.classId}}" bindtap="onPickClass">
      <icon-cell src="{{item.iconUrl}}" size="cls" label="{{item.nameCn}}" />
      <view class="cls-name">{{item.nameCn}}</view>
    </view>
  </view>
  <view wx:else class="muted cls-empty">{{classEmpty}}</view>

  <!-- 4）选中职业的可选种族与种族特长：图标 + 文字都要有 -->
  <block wx:if="{{activeName}}">
    <view class="race-bar">
      <view class="sec-title race-title">{{activeName}} · 可选种族</view>
      <view class="race-go" bindtap="goClass">看技能书与天赋树 →</view>
    </view>
    <view wx:if="{{raceNote}}" class="muted race-none">{{raceNote}}</view>
    <view class="race plate" wx:for="{{races}}" wx:key="key">
      <view class="race-top">
        <!-- 缺图就让它显示首字块：88rpx 的格子里塞"没有这张图标"六个字会被裁成"没有这"，
             既难看又读不完（暗夜精灵那条实拍里就是这样） -->
        <icon-cell src="{{item.iconUrl}}" size="md" label="{{item.nameCn}}" />
        <view class="race-id">
          <view class="race-name">
            {{item.nameCn}}
            <text wx:if="{{item.nameMissing}}" class="todo">中文名待补</text>
          </view>
          <view class="race-fac">{{item.factionText}}<text wx:if="{{item.subCn}}" class="race-sub">{{item.subCn}}</text></view>
        </view>
      </view>
      <view wx:if="{{item.traits.length}}" class="traits">
        <view class="trait" wx:for="{{item.traits}}" wx:for-item="t" wx:key="key">
          <icon-cell src="{{t.iconUrl}}" size="sm" label="{{t.name}}" />
          <view class="trait-main">
            <view class="trait-name">
              {{t.name}}
              <text wx:if="{{t.passive}}" class="trait-pass">被动</text>
            </view>
            <view wx:if="{{t.effect}}" class="trait-eff">{{t.effect}}</view>
            <view wx:else class="muted trait-eff">效果待补</view>
          </view>
        </view>
      </view>
      <view wx:else class="muted trait-none">种族特长待补</view>
    </view>
  </block>

  <block wx:if="{{recent.length}}">
    <view class="sec-title sec-title-2">最近查看</view>
    <scroll-view class="rail" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="mini plate" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecentTap">
        <view class="mini-name">{{item.title}}</view>
        <view class="mini-meta">
          <text class="mini-range">{{item.range}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
</view>
