<view class="wrap">
  <!-- 页面背景：《无限》那张氛围底图（本站自生成，与网页首页 hero 同一张），压暗后文字才读得清。
       取不到图（断网、没发素材）就不渲染这一层，版式回落到 app.wxss 的纯色底。 -->
  <image wx:if="{{bgUrl}}" class="pagebg-ambient" src="{{bgUrl}}" mode="aspectFill" />
  <image wx:if="{{bgUrl}}" class="pagebg" src="{{bgUrl}}" mode="widthFix" binderror="onArtError" data-k="bg" />
  <view wx:if="{{bgUrl}}" class="pagebg-scrim"></view>

  <!-- 内容层：背景那两层是页面顶上的 absolute，这一层靠 relative + z-index 浮到它们上面 -->
  <view class="fg">
  <view class="hero-space"></view>
  <view class="hairline"></view>

  <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
    这批数据的结构比当前小程序新，界面可能显示不全。请在微信里更新「跑本助手」后再看。
  </view>
  <view wx:elif="{{offline}}" class="notice">
    现在没连上线，显示的是上次存下的内容。要联网取的部分会明说。
  </view>

  <!-- 1）开服倒计时：占顶部约 1/4 屏，正式服上线后这一整块由页面移除。
        站主 2026-10-22 二次指令：只到天，不做秒表 → 这里没有时:分:秒，也不每秒刷 -->
  <view wx:if="{{cd}}" class="cd plate">
    <view class="cd-brand">跑本助手<text class="cd-sub">《无限》中文资料</text></view>
    <view class="cd-kicker">距正式服上线</view>
    <view class="cd-row">
      <block wx:if="{{cd.today}}">
        <text class="cd-today">就在今天</text>
      </block>
      <block wx:else>
        <text class="cd-num">{{cd.d}}</text>
        <text class="cd-unit">天</text>
      </block>
    </view>
    <view class="cd-note">{{cd.dayText}} 上线（北京时间）· 官方公告只公布到日，具体开服时刻以游戏内为准</view>
  </view>
  <view wx:else class="hero">
    <view class="hero-title">跑本助手</view>
    <view class="hero-sub">《无限》中文资料 · 每条可溯源 · 缺的直说待实测</view>
  </view>

  <!-- 2）六个入口：BIS配装 / 角色起名 / 副本 / 掉落查询 / 宏命令 / 职业（专业另加，开关控）。
       2026-11-03 站主指令：布局照截图重排——BIS、起名不再是整宽卡，六卡统一进两列格，
       顺序按截图（BIS、起名排前两格）；这两格换自绘图标（img/home/，官方 CDN 没有这类 UI 图），
       其余四格的图标与底图一律不动、文案一字未改，只动排布。
       受远程开关的格（namer/macros/professions）照旧：关着整格不渲染，不留空白格。 -->
  <view class="grid">
    <view class="entry plate" bindtap="goBis">
      <view class="entry-head">
        <image class="entry-ic" src="/img/home/bis-icon.png" mode="aspectFit" />
        <view class="entry-name">BIS配装</view>
      </view>
      <view class="entry-desc">30 级这一档，按职业和阵营列：这一身穿什么、这个部位还能换什么。</view>
    </view>
    <!-- 角色起名：2026-11-03 站主指令新增，受远程开关 namer 控制（app/data/flags.json）。 -->
    <view wx:if="{{openNamer}}" class="entry plate" bindtap="goNamer">
      <view class="entry-head">
        <image class="entry-ic" src="/img/home/namer-icon.png" mode="aspectFit" />
        <view class="entry-name">角色起名</view>
      </view>
      <view class="entry-desc">挑个职业摇一摇：搞笑谐音名随机滚，看中哪个复制哪个，还能自己改。</view>
    </view>
    <view class="entry plate" bindtap="goDungeons">
      <image wx:if="{{cardBg.dungeons}}" class="entry-art" src="{{cardBg.dungeons}}" mode="aspectFill"
             binderror="onArtError" data-k="dungeons" />
      <view class="entry-scrim"></view>
      <view class="entry-name">副本</view>
      <view class="entry-desc">五人本名单：等级、阵营、地图、首领与掉落。</view>
    </view>
    <view class="entry plate" bindtap="goLoots">
      <image wx:if="{{cardBg.loots}}" class="entry-art" src="{{cardBg.loots}}" mode="aspectFill"
             binderror="onArtError" data-k="loots" />
      <view class="entry-scrim"></view>
      <view class="entry-name">掉落查询</view>
      <view class="entry-desc">搜副本或物品名，直接跳到那座本看这件谁掉。</view>
    </view>
    <!-- 宏命令：站主 2026-11-02 指令进首页第四格，受远程开关 macros 控制。 -->
    <view wx:if="{{openMacros}}" class="entry plate" bindtap="goMacros">
      <image wx:if="{{cardBg.macros}}" class="entry-art" src="{{cardBg.macros}}" mode="aspectFill"
             binderror="onArtError" data-k="macros" />
      <view class="entry-scrim"></view>
      <view class="entry-name">宏命令</view>
      <view class="entry-desc">按职业挑、能搜：正文原样复制进游戏就能用。</view>
    </view>
    <view class="entry plate" bindtap="goClasses">
      <image wx:if="{{cardBg.classes}}" class="entry-art" src="{{cardBg.classes}}" mode="aspectFill"
             binderror="onArtError" data-k="classes" />
      <view class="entry-scrim"></view>
      <view class="entry-name">职业</view>
      <view class="entry-desc">种族与可选职业、技能书和天赋树，天赋可以分享。</view>
    </view>
    <!-- 专业与配方：受远程开关 professions 控制（app/data/flags.json），
         关着的时候整块不渲染——不占位、不留空白格；线上拧开不用发小程序版本。 -->
    <view wx:if="{{openProfessions}}" class="entry plate" bindtap="goProfessions">
      <image wx:if="{{cardBg.professions}}" class="entry-art" src="{{cardBg.professions}}" mode="aspectFill"
             binderror="onArtError" data-k="professions" />
      <view class="entry-scrim"></view>
      <view class="entry-name">专业与配方</view>
      <view class="entry-desc">按技能档位分箱：这点技能能做什么、下一步要什么材料。</view>
    </view>
  </view>

  <!-- 3）职业格：九个一排铺开、超出换行，不做出横向滚动（站主 2026-10-22 明确要求）；
       标题 2026-11-03 照截图改成「选择你的职业」 -->
  <view class="sec-title">选择你的职业</view>
  <view wx:if="{{classes.length}}" class="cls9">
    <view class="cls {{activeClass === item.classId ? 'cls-on' : ''}}" wx:for="{{classes}}" wx:key="classId"
          data-id="{{item.classId}}" bindtap="onPickClass">
      <icon-cell src="{{item.iconUrl}}" size="cls" label="{{item.nameCn}}" />
      <view class="cls-name">{{item.nameCn || '待核'}}</view>
    </view>
  </view>
  <view wx:else class="muted cls-empty">{{classEmpty}}</view>

  <!-- 4）选中职业的可选种族与种族特长：图标 + 文字都要有 -->
  <block wx:if="{{activeName}}">
    <view class="race-bar">
      <view class="sec-title race-title">{{activeName}} · 可选种族</view>
      <view class="race-go" bindtap="goClass">看技能书与天赋树 →</view>
    </view>
    <view wx:if="{{raceNote}}" class="muted race-none">{{raceNote}}</view>
    <view class="race plate" wx:for="{{races}}" wx:key="key">
      <view class="race-top">
        <!-- 缺图就让它显示首字块：88rpx 的格子里塞"没有这张图标"六个字会被裁成"没有这"，
             既难看又读不完（暗夜精灵那条实拍里就是这样） -->
        <icon-cell src="{{item.iconUrl}}" size="md" label="{{item.nameCn}}" />
        <view class="race-id">
          <view class="race-name">
            {{item.nameCn}}
            <text wx:if="{{item.nameMissing}}" class="todo">中文名待核</text>
          </view>
          <view class="race-fac">{{item.factionText}}<text wx:if="{{item.subCn}}" class="race-sub">{{item.subCn}}</text></view>
        </view>
      </view>
      <view wx:if="{{item.traits.length}}" class="traits">
        <view class="trait" wx:for="{{item.traits}}" wx:for-item="t" wx:key="key">
          <icon-cell src="{{t.iconUrl}}" size="sm" label="{{t.name}}" />
          <view class="trait-main">
            <view class="trait-name">
              {{t.name}}
              <text wx:if="{{t.passive}}" class="trait-pass">被动</text>
            </view>
            <view wx:if="{{t.effect}}" class="trait-eff">{{t.effect}}</view>
            <view wx:else class="muted trait-eff">这条效果还没核到，不抄。</view>
          </view>
        </view>
      </view>
      <view wx:else class="muted trait-none">这个种族的特长还没核到。</view>
    </view>
  </block>

  <block wx:if="{{recent.length}}">
    <view class="sec-title sec-title-2">继续</view>
    <scroll-view class="rail" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="mini plate" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecentTap">
        <view class="mini-name">{{item.title}}</view>
        <view class="mini-meta">
          <text class="mini-range">{{item.range}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <view class="foot" bindtap="onDisclaimer">非官方粉丝资料站，与暴雪娱乐及网易无关（点击查看声明）</view>
  </view>
</view>
