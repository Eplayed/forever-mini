.home {
  background: var(--adventure-bg) top / 100% 1360rpx no-repeat;
  animation: home-reveal 240ms ease-out both;
}

@keyframes home-reveal {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .home { animation: none; }
}

.masthead, .launch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.masthead { margin-bottom: 18rpx; }
.mast-name { color: var(--txt-title); font-size: 38rpx; font-weight: 750; }
.mast-tag, .feature-tag {
  color: var(--gold-hi);
  border: 1rpx solid var(--gold-line);
  background: var(--foot);
  font-size: 21rpx;
  padding: 2rpx 12rpx;
}

.launch { margin-bottom: 14rpx; color: var(--gold-hi); font-size: 23rpx; }

.spotlight {
  height: 356rpx;
  border: 2rpx solid var(--gold);
  border-radius: 8rpx;
  overflow: hidden;
}

.feature {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  background: var(--panel);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.feature-art, .feature-scrim, .entry-art, .entry-scrim {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.feature-scrim { background: var(--home-feature-scrim); }
.feature-body { position: relative; padding: 28rpx; }
.feature-title { font-weight: 800; font-size: 53rpx; line-height: 1.22; color: var(--txt-title); margin-top: 10rpx; }
.feature-desc { color: var(--txt); font-size: 25rpx; margin-top: 6rpx; }
.feature-cta {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 5rpx 18rpx;
  margin-top: 15rpx;
  background: var(--jade);
  border: 1rpx solid var(--jade-line);
  color: var(--txt-title);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: var(--r-ctl);
}

.feature-tabs { display: flex; gap: 12rpx; margin-top: 10rpx; }
.feature-tab {
  flex: 1;
  color: var(--txt-dim);
  background: var(--foot);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  font-size: 22rpx;
  line-height: 2.2;
}
.feature-tab-on { color: var(--gold-hi); background: var(--panel-2); border-color: var(--gold-line); box-shadow: inset 0 -3rpx var(--gold); }

.sec-title {
  color: var(--gold-hi);
  font-size: 27rpx;
  font-weight: 700;
  margin: 24rpx 0 12rpx;
}
.sec-title-2 { margin-top: 24rpx; }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.entry {
  position: relative;
  overflow: hidden;
  min-width: 0;
  padding: 18rpx;
  box-sizing: border-box;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 7rpx;
}
.priority-entry {
  min-height: 126rpx;
  display: flex;
  align-items: flex-end;
  border-color: var(--gold-line);
  background: var(--panel);
}
.entry-scrim { background: var(--home-tile-scrim); }
.entry-content { position: relative; width: 100%; }
.entry-emblem { position: absolute; width: 108rpx; height: 108rpx; right: 21rpx; top: 9rpx; opacity: 0.42; }
.entry-name { position: relative; font-size: 27rpx; font-weight: 700; color: var(--txt-title); padding-right: 24rpx; }
.entry-arrow { position: absolute; right: 0; top: 0; color: var(--gold-hi); }
.entry-desc { position: relative; font-size: 21rpx; color: var(--txt); margin-top: 2rpx; }
.entry-pressed { border-color: var(--gold-hi); background: var(--panel); }
.tool-icon { position: absolute; width: 48rpx; height: 48rpx; right: 36rpx; top: 17rpx; opacity: 0.26; }

.cls9 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8rpx; }
.cls { min-width: 0; text-align: center; padding: 8rpx 0; border: 1rpx solid transparent; }
.cls-on { border-color: var(--gold-line); background: var(--panel-2); }
.cls-name { font-size: 21rpx; color: var(--txt-dim); }

.cls-empty {
  margin-bottom: 10rpx;
}

/* —— 选中职业的种族与特长 —— */
.race-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 12rpx;
}

.race-title {
  margin: 0;
}

.race-go {
  font-size: 22rpx;
  color: var(--gold);
}

.race-none {
  margin-bottom: 16rpx;
}

.race {
  background: var(--glass-sheen), var(--panel-glass);
  border: 1rpx solid var(--gold-line-soft);
  border-radius: var(--r-ctl);
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 16rpx;
}

.race-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.race-id {
  margin-left: 18rpx;
}

.race-name {
  font-size: 28rpx;
  color: var(--txt-title);
}

.race-fac {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 2rpx;
}

/* 子族名（天裔分塑风者 / 高阶会两条，光看"天裔"分不出谁是谁） */
.race-sub {
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--txt-hint);
}

.trait {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
}

.trait-main {
  flex: 1;
  margin-left: 16rpx;
}

.trait-name {
  font-size: 24rpx;
  color: var(--txt);
}

.trait-pass {
  font-size: 18rpx;
  color: var(--txt-muted);
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
}

.trait-eff {
  font-size: 22rpx;
  color: var(--txt-muted);
  line-height: 1.55;
  margin-top: 2rpx;
}

.trait-none {
  padding: 2rpx 0 14rpx;
}

/* 缺数据标记：与副本页同款虚线小框（页面级样式，全局不掺） */
.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.rail {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.mini {
  display: inline-block;
  width: 260rpx;
  margin-right: 14rpx;
  padding: 18rpx;
  background: var(--glass-sheen), var(--panel-glass);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
  vertical-align: top;
}

.mini-name {
  font-size: 26rpx;
  color: var(--txt-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.mini-range {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
}
