/* 首页样式。颜色一律吃 app.wxss 的令牌，这里不写裸色值；
   切角铭牌 .plate、.foot、.muted 都在全局定义，页面只补布局。
   2026-10-22 站主重排后新增：开服倒计时 .cd 开头、职业格 .cls9 与 .cls、
   种族与特长 .race 与 .trait 开头。上一版留给覆盖率读数与缺口清单的样式已随界面一起删掉。 */

/* —— 底图两层（2026-10-22 站主：卡片配图、页面背景用《无限》那张氛围图）——
   .pagebg 是图，.pagebg-scrim 是压在图上的暗底（不压暗，原画的亮部会把文字吃掉），
   .fg 把所有内容浮到这两层上面。图取不到时这两层整个不渲染，页面就是原来的纯色版式。 */
.pagebg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.pagebg-scrim {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: var(--scrim-page);
}

.fg {
  position: relative;
  z-index: 1;
}

.hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--txt-title);
}

.hero-sub {
  font-size: 24rpx;
  color: var(--txt-dim);
  margin-top: 6rpx;
}

/* —— 开服倒计时：站主要它占顶部约 1/4 屏（iPhone 6 上一屏 1334rpx，取 330rpx）——
   这块不写"数据核对到哪天"之类的话，只回答"还有几天开服"；过了那天页面直接不渲染。 */
.cd {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 330rpx;
  margin-bottom: 30rpx;
  padding: 26rpx 24rpx 24rpx;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
}

.cd-brand {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--txt-dim);
}

.cd-sub {
  font-size: 20rpx;
  letter-spacing: 0;
  color: var(--txt-muted);
  margin-left: 14rpx;
}

.cd-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
  margin-top: 22rpx;
}

.cd-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

/* 天数是这块的主读数：字号拉开一档，数字用等宽避免每秒跳动时宽度抖 */
.cd-num {
  font-size: 92rpx;
  line-height: 1.05;
  font-weight: 600;
  color: var(--gold-hi);
  font-family: Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.cd-unit {
  font-size: 26rpx;
  color: var(--txt-dim);
  margin-left: 8rpx;
}

/* 只剩半天时不写"0 天"，换成这一句（字号收一档，它是一句话不是一个数） */
.cd-today {
  font-size: 64rpx;
  line-height: 1.2;
  font-weight: 600;
  color: var(--gold-hi);
}

.cd-note {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 10rpx;
  line-height: 1.5;
}

.sec-title {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
  margin: 4rpx 0 14rpx;
}

.sec-title-2 {
  margin-top: 28rpx;
}

/* 流式入口卡：一行两张，容器变窄自动换行 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.entry {
  position: relative;
  overflow: hidden;
  flex: 1 1 300rpx;
  min-width: 300rpx;
  min-height: 200rpx;
  margin: 0 8rpx 16rpx;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  padding: 24rpx 22rpx 20rpx;
  box-sizing: border-box;
}

/* 卡的底图铺满整格，上面再压一层由下往上的暗渐变：
   上半留原画、下半保证名称与那行说明读得清 */
.entry-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.entry-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(180deg, var(--scrim-card) 0%, var(--scrim-card-b) 78%);
}

.entry-name {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  color: var(--txt-title);
}

.entry-desc {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: var(--txt-dim);
  margin-top: 10rpx;
  min-height: 66rpx;
}

/* —— 职业格 ——
   格子的版式（一行五格、超出换行、选中态）在 app.wxss 里与职业页共用一份，
   这里只留首页特有的两句：不许出现横向滚动条（站主 2026-10-22 明确要求），
   所以这一排不用 scroll-view 包——全页只有"最近看过"那条轨用横滚。 */
.cls-empty {
  margin-bottom: 10rpx;
}

/* —— 选中职业的种族与特长 —— */
.race-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 12rpx;
}

.race-title {
  margin: 0;
}

.race-go {
  font-size: 22rpx;
  color: var(--gold);
}

.race-none {
  margin-bottom: 16rpx;
}

.race {
  background: var(--panel-2);
  border: 1rpx solid var(--gold-line-soft);
  border-radius: var(--r-ctl);
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 16rpx;
}

.race-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.race-id {
  margin-left: 18rpx;
}

.race-name {
  font-size: 28rpx;
  color: var(--txt-title);
}

.race-fac {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 2rpx;
}

/* 子族名（天裔分塑风者 / 高阶会两条，光看"天裔"分不出谁是谁） */
.race-sub {
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--txt-hint);
}

.trait {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
}

.trait-main {
  flex: 1;
  margin-left: 16rpx;
}

.trait-name {
  font-size: 24rpx;
  color: var(--txt);
}

.trait-pass {
  font-size: 18rpx;
  color: var(--txt-muted);
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
}

.trait-eff {
  font-size: 22rpx;
  color: var(--txt-muted);
  line-height: 1.55;
  margin-top: 2rpx;
}

.trait-none {
  padding: 2rpx 0 14rpx;
}

/* 缺数据标记：与副本页同款虚线小框（页面级样式，全局不掺） */
.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.rail {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.mini {
  display: inline-block;
  width: 260rpx;
  margin-right: 14rpx;
  padding: 18rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
  vertical-align: top;
}

.mini-name {
  font-size: 26rpx;
  color: var(--txt-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.mini-range {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
}
