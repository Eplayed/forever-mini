/* 首页样式。颜色一律吃 app.wxss 的令牌，这里不写裸色值；
   切角铭牌 .plate、徽标 .badge-L* 都在全局定义，页面只补布局。 */

.hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--txt-title);
}

.hero-sub {
  font-size: 24rpx;
  color: var(--txt-dim);
  margin-top: 6rpx;
}

.hero-state {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--txt-muted);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.dot-ok {
  background: var(--gold-hot);
}

.dot-warn {
  background: var(--warn);
}

.hero-date {
  margin-left: 16rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid var(--line);
}

.sec-title {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
  margin: 4rpx 0 14rpx;
}

.sec-title-2 {
  margin-top: 28rpx;
}

/* 流式入口卡：一行两张，容器变窄自动换行 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.entry {
  flex: 1 1 300rpx;
  min-width: 300rpx;
  margin: 0 8rpx 16rpx;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  padding: 24rpx 22rpx 20rpx;
  box-sizing: border-box;
}

.entry-name {
  font-size: 26rpx;
  color: var(--txt-dim);
}

.entry-num {
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 600;
  color: var(--gold-hi);
  margin-top: 4rpx;
}

.entry-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--txt-dim);
  margin-left: 6rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: var(--txt-muted);
  margin-top: 10rpx;
  min-height: 66rpx;
}

.entry-go {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gold-line-soft);
  font-size: 24rpx;
  color: var(--gold);
}

.rail {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.mini {
  display: inline-block;
  width: 260rpx;
  margin-right: 14rpx;
  padding: 18rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
  vertical-align: top;
}

.mini-name {
  font-size: 26rpx;
  color: var(--txt-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.mini-range {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
}

.panel {
  background: var(--panel-2);
  border: 1rpx solid var(--gold-line-soft);
  border-radius: var(--r-ctl);
  padding: 20rpx 22rpx;
}

.levels {
  display: flex;
  align-items: flex-start;
}

.lv {
  width: 96rpx;
}

.lv-num {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.lv-key {
  font-size: 20rpx;
  color: var(--txt-muted);
}

/* 分级是有序量：颜色只走明度阶梯，不用色相（色盲与暗光下也分得出高低） */
.lv-L0 {
  color: var(--lv0);
}

.lv-L1 {
  color: var(--lv1);
}

.lv-L2 {
  color: var(--lv2);
}

.lv-L3 {
  color: var(--lv3);
}

.levels-side {
  flex: 1;
  text-align: right;
}

.levels-go {
  font-size: 22rpx;
  color: var(--gold);
  margin-top: 6rpx;
}

.lv-legend {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.lv-legend .badge {
  margin-right: 10rpx;
}

.gap {
  display: flex;
  font-size: 24rpx;
  color: var(--txt);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.gap-mark {
  color: var(--gold);
  margin-right: 10rpx;
}

.gap-note {
  padding: 12rpx 0 4rpx;
}

.wip .chip {
  border-style: dashed;
}

.chip-wip {
  color: var(--txt-muted);
}

.wip-note {
  margin-top: 4rpx;
}
