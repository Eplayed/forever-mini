/* 首页样式。颜色一律吃 app.wxss 的令牌，这里不写裸色值；
   切角铭牌 .plate、.foot、.muted 都在全局定义，页面只补布局。
   2026-10-22 站主重排后新增：开服倒计时 .cd 开头、职业格 .cls9 与 .cls、
   种族与特长 .race 与 .trait 开头。上一版留给覆盖率读数与缺口清单的样式已随界面一起删掉。 */

.hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--txt-title);
}

.hero-sub {
  font-size: 24rpx;
  color: var(--txt-dim);
  margin-top: 6rpx;
}

/* —— 开服倒计时：站主要它占顶部约 1/4 屏（iPhone 6 上一屏 1334rpx，取 330rpx）——
   这块不写"数据核对到哪天"之类的话，只回答"还有几天开服"；过了那天页面直接不渲染。 */
.cd {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 330rpx;
  margin-bottom: 30rpx;
  padding: 26rpx 24rpx 24rpx;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
}

.cd-brand {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--txt-dim);
}

.cd-sub {
  font-size: 20rpx;
  letter-spacing: 0;
  color: var(--txt-muted);
  margin-left: 14rpx;
}

.cd-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
  margin-top: 22rpx;
}

.cd-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

/* 天数是这块的主读数：字号拉开一档，数字用等宽避免每秒跳动时宽度抖 */
.cd-num {
  font-size: 92rpx;
  line-height: 1.05;
  font-weight: 600;
  color: var(--gold-hi);
  font-family: Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.cd-unit {
  font-size: 26rpx;
  color: var(--txt-dim);
  margin-left: 8rpx;
}

/* 只剩半天时不写"0 天"，换成这一句（字号收一档，它是一句话不是一个数） */
.cd-today {
  font-size: 64rpx;
  line-height: 1.2;
  font-weight: 600;
  color: var(--gold-hi);
}

.cd-note {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 10rpx;
  line-height: 1.5;
}

.sec-title {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
  margin: 4rpx 0 14rpx;
}

.sec-title-2 {
  margin-top: 28rpx;
}

/* 流式入口卡：一行两张，容器变窄自动换行 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.entry {
  flex: 1 1 300rpx;
  min-width: 300rpx;
  margin: 0 8rpx 16rpx;
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
  padding: 24rpx 22rpx 20rpx;
  box-sizing: border-box;
}

.entry-name {
  font-size: 26rpx;
  color: var(--txt-dim);
}

.entry-desc {
  font-size: 22rpx;
  color: var(--txt-muted);
  margin-top: 10rpx;
  min-height: 66rpx;
}

.entry-go {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gold-line-soft);
  font-size: 24rpx;
  color: var(--gold);
}

/* —— 职业格 ——
   站主要"按红框那样一排圆形图标铺开，多出来不要横向滚动条"：
   这里用 5 列 grid + 自动换行（9 个职业 → 5 + 4），
   绝不用 scroll-view 包它——横滚在小程序里看不见"还有多少个"，也不符合"不要滚动条"那句。 */
.cls9 {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx 10rpx;
}

/* 一行五格（750rpx 屏宽下每格 138rpx，装得下 96rpx 圆图标 + 三字名），
   第九个自己换到第二行——不用 display:grid 是为了不在老内核上赌层叠支持 */
.cls {
  flex: 0 0 20%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 14rpx 4rpx 10rpx;
  border: 1rpx solid transparent;
  border-radius: var(--r-ctl);
}

/* 选中态三通道：金色描边 + 底色抬起 + 名字变金，不只靠颜色（暗光与色盲也分得出） */
.cls-on {
  background: var(--panel);
  border-color: var(--gold);
}

.cls-name {
  font-size: 22rpx;
  color: var(--txt-dim);
  margin-top: 8rpx;
}

.cls-on .cls-name {
  color: var(--gold-hi);
}

/* —— 选中职业的种族与特长 —— */
.race-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 12rpx;
}

.race-title {
  margin: 0;
}

.race-go {
  font-size: 22rpx;
  color: var(--gold);
}

.race-none {
  margin-bottom: 16rpx;
}

.race {
  background: var(--panel-2);
  border: 1rpx solid var(--gold-line-soft);
  border-radius: var(--r-ctl);
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 16rpx;
}

.race-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.race-id {
  margin-left: 18rpx;
}

.race-name {
  font-size: 28rpx;
  color: var(--txt-title);
}

.race-fac {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 2rpx;
}

.trait {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
}

.trait-main {
  flex: 1;
  margin-left: 16rpx;
}

.trait-name {
  font-size: 24rpx;
  color: var(--txt);
}

.trait-pass {
  font-size: 18rpx;
  color: var(--txt-muted);
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
}

.trait-eff {
  font-size: 22rpx;
  color: var(--txt-muted);
  line-height: 1.55;
  margin-top: 2rpx;
}

.trait-none {
  padding: 2rpx 0 14rpx;
}

/* 缺数据标记：与副本页同款虚线小框（页面级样式，全局不掺） */
.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.rail {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.mini {
  display: inline-block;
  width: 260rpx;
  margin-right: 14rpx;
  padding: 18rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
  vertical-align: top;
}

.mini-name {
  font-size: 26rpx;
  color: var(--txt-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.mini-range {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
}
