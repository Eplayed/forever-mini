.home {
  background: var(--forge-surface), var(--bg);
}

@keyframes home-reveal {
  from { opacity: 0.75; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.adventure-card, .spotlight, .priority {
  animation: home-reveal 180ms ease-out both;
}

.priority { animation-delay: 40ms; }

.feature-selected .feature-body {
  animation: home-reveal 160ms ease-out both;
}

.masthead, .launch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.masthead { margin-bottom: 16rpx; }
.mast-name { color: var(--txt-title); font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; }
.mast-tag {
  color: var(--gold-hi);
  background: var(--forge-surface-active);
  box-shadow: var(--forge-inset);
  border: 1rpx solid var(--forge-edge);
  clip-path: polygon(0 0, calc(100% - 9rpx) 0, 100% 9rpx, 100% 100%, 0 100%);
  font-size: 20rpx;
  padding: 3rpx 14rpx;
}

.launch { margin-bottom: 14rpx; color: var(--gold-hi); font-size: 23rpx; }

.spotlight {
  height: 312rpx;
  border: 1rpx solid var(--forge-edge-active);
  border-radius: var(--r-ctl);
  box-shadow: var(--forge-shadow);
  overflow: hidden;
}

.feature {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  background: var(--forge-surface);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.feature::after {
  content: '';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 28rpx;
  border-top: 1rpx solid var(--forge-edge-active);
  border-right: 1rpx solid var(--forge-edge-active);
  pointer-events: none;
}

.feature-art, .feature-scrim, .entry-art, .entry-scrim {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.feature-scrim { background: var(--home-feature-scrim); }
.feature-body { position: relative; padding: 24rpx; }
.feature-title { font-weight: 800; font-size: 48rpx; line-height: 1.18; color: var(--txt-title); }
.feature-desc { color: var(--txt); font-size: 24rpx; margin-top: 6rpx; }
.feature-cta {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 16rpx;
  margin-top: 12rpx;
  background: var(--gold-hot);
  color: var(--accent-ink);
  font-size: 22rpx;
  font-weight: 700;
  clip-path: polygon(0 0, calc(100% - 10rpx) 0, 100% 10rpx, 100% 100%, 0 100%);
}

.feature-tabs { display: flex; gap: 10rpx; margin-top: 6rpx; }
.feature-tab {
  flex: 1;
  line-height: 1.4;
  min-height: 78rpx;
  padding: 10rpx;
  color: var(--txt-dim);
  background: var(--forge-surface);
  border: 1rpx solid var(--forge-edge);
  border-radius: var(--r-ctl);
  box-shadow: var(--forge-inset);
  font-size: 23rpx;
  font-weight: 600;
}
.feature-tab-on {
  color: var(--gold-hi);
  background: var(--forge-surface-active);
  border-color: var(--forge-edge-active);
  box-shadow: inset 0 -3rpx var(--gold);
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--gold-hi);
  font-size: 26rpx;
  font-weight: 700;
  margin: 20rpx 0 10rpx;
}
.sec-title::before { content: ''; width: 4rpx; height: 22rpx; background: var(--gold); }
.sec-title-2 { margin-top: 24rpx; }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.entry {
  position: relative;
  overflow: hidden;
  min-width: 0;
  padding: 16rpx;
  box-sizing: border-box;
  background: var(--forge-surface);
  border: 1rpx solid var(--forge-edge);
  border-radius: var(--r-ctl);
  box-shadow: var(--forge-inset);
}
.priority-entry {
  min-height: 118rpx;
  display: flex;
  align-items: flex-end;
}
.priority-bis { border-color: var(--forge-edge-active); }
.priority-bis .entry-name { color: var(--gold-hi); }
.leveling-entry { background: var(--glass-sheen), var(--forge-surface); }
.entry-scrim { background: var(--home-tile-scrim); }
.entry-content { position: relative; width: 100%; }
.entry-emblem { position: absolute; width: 84rpx; height: 84rpx; right: 18rpx; top: 11rpx; opacity: 0.45; }
.entry-name { position: relative; font-size: 27rpx; line-height: 1.4; font-weight: 700; color: var(--txt-title); padding-right: 24rpx; }
.entry-arrow { position: absolute; right: 0; top: 0; color: var(--gold-hi); }
.entry-desc { position: relative; font-size: 22rpx; line-height: 1.35; color: var(--txt); margin-top: 5rpx; }
.entry, .feature-tab, .leveling-card, .adventure-main, .adventure-continue { transition: transform 110ms ease-out; }
.home .entry-pressed { border-color: var(--forge-edge-active); box-shadow: var(--forge-focus); transform: scale(0.97); }
.tool-icon { position: absolute; width: 48rpx; height: 48rpx; right: 36rpx; top: 17rpx; opacity: 0.26; }

.cls9 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8rpx; }
.cls { min-width: 0; text-align: center; padding: 8rpx 0; border: 1rpx solid transparent; }
.cls-on { border-color: var(--gold-line); background: var(--panel-2); }
.cls-name { font-size: 21rpx; color: var(--txt-dim); }

.cls-empty {
  margin-bottom: 10rpx;
}

/* —— 选中职业的种族与特长 —— */
.race-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 12rpx;
}

.race-title {
  margin: 0;
}

.race-toggle {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--txt-muted);
  margin-left: 10rpx;
}

.race-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}

.race-chip {
  font-size: 22rpx;
  color: var(--txt);
  padding: 4rpx 14rpx;
  background: var(--foot);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
}

.race-chip-more {
  font-size: 21rpx;
  color: var(--gold);
  padding: 4rpx 10rpx;
}

.race-go {
  font-size: 22rpx;
  color: var(--gold);
}

.race-none {
  margin-bottom: 16rpx;
}

.race {
  background: var(--glass-sheen), var(--panel-glass);
  border: 1rpx solid var(--gold-line-soft);
  border-radius: var(--r-ctl);
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 16rpx;
}

.race-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.race-id {
  margin-left: 18rpx;
}

.race-name {
  font-size: 28rpx;
  color: var(--txt-title);
}

.race-fac {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-top: 2rpx;
}

/* 子族名（天裔分塑风者 / 高阶会两条，光看"天裔"分不出谁是谁） */
.race-sub {
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--txt-hint);
}

.trait {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
}

.trait-main {
  flex: 1;
  margin-left: 16rpx;
}

.trait-name {
  font-size: 24rpx;
  color: var(--txt);
}

.trait-pass {
  font-size: 18rpx;
  color: var(--txt-muted);
  border: 1rpx solid var(--line-2);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
}

.trait-eff {
  font-size: 22rpx;
  color: var(--txt-muted);
  line-height: 1.55;
  margin-top: 2rpx;
}

.trait-none {
  padding: 2rpx 0 14rpx;
}

/* 缺数据标记：与副本页同款虚线小框（页面级样式，全局不掺） */
.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.rail {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.mini {
  display: inline-block;
  width: 260rpx;
  margin-right: 14rpx;
  padding: 18rpx;
  background: var(--glass-sheen), var(--panel-glass);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-ctl);
  box-sizing: border-box;
  vertical-align: top;
}

.mini-name {
  font-size: 26rpx;
  color: var(--txt-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.mini-range {
  font-size: 20rpx;
  color: var(--txt-muted);
  margin-left: 10rpx;
}

.adventure-card { position: relative; margin-bottom: 16rpx; border: 1rpx solid var(--forge-edge); border-radius: var(--r-ctl); background: var(--glass-sheen), var(--forge-surface); box-shadow: var(--forge-inset); }
.adventure-card::before { content: ''; position: absolute; top: 0; left: 15rpx; right: 15rpx; height: 2rpx; background: var(--forge-line); pointer-events: none; }
.adventure-main, .adventure-continue { display: flex; min-height: 76rpx; box-sizing: border-box; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 20rpx; color: var(--gold-hi); font-size: 26rpx; line-height: 1.4; }
.adventure-title { color: var(--gold-hi); font-size: 29rpx; font-weight: 750; }
.adventure-book { display: block; flex: 0 0 54rpx; width: 54rpx; height: 54rpx; box-sizing: border-box; border: 1rpx solid var(--gold-line); border-radius: 7rpx; }
.adventure-copy { flex: 1; min-width: 0; }
.adventure-detail { margin-top: 3rpx; color: var(--txt-dim); font-size: 22rpx; }
.adventure-arrow { color: var(--gold-hi); font-size: 34rpx; }
.adventure-continue { border-top: 1rpx solid var(--gold-line); }
.adventure-continue > text:first-child { flex-shrink: 0; }
.adventure-dungeon { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.leveling-heading { display: flex; justify-content: space-between; align-items: baseline; }
.leveling-all { color: var(--gold-hi); font-size: 24rpx; padding: 14rpx 0 14rpx 14rpx; }
.leveling-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.leveling-card { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: 5rpx; padding: 14rpx; border: 1rpx solid var(--forge-edge); border-radius: var(--r-ctl); background: var(--forge-surface); box-shadow: var(--forge-inset); }
.leveling-class { font-size: 27rpx; font-weight: 700; color: var(--txt-title); }
.leveling-name { font-size: 22rpx; color: var(--txt-dim); }
.leveling-feature { width: 100%; box-sizing: border-box; margin-top: 3rpx; padding-top: 7rpx; border-top: 1rpx solid var(--gold-line); color: var(--gold-hi); font-size: 22rpx; line-height: 1.35; white-space: pre-line; }

/* 区服 G 排行卡（2026-11-24 站主拍板：位于常用查询上方，只用 G/g/米） */
.grank-card {
  position: relative;
  margin-top: 22rpx;
  padding: 18rpx 20rpx 14rpx;
  border: 1rpx solid var(--forge-edge);
  border-radius: var(--r-ctl);
  background: var(--glass-sheen), var(--forge-surface);
  box-shadow: var(--forge-inset), var(--forge-shadow);
}
.grank-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 16rpx;
  right: 16rpx;
  height: 2rpx;
  background: var(--forge-line);
  pointer-events: none;
}
.grank-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.grank-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.grank-title {
  color: var(--gold-hi);
  font-size: 29rpx;
  font-weight: 750;
}
.grank-unit {
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--gold-line);
  border-radius: 8rpx;
  background: var(--gold-glow);
  color: var(--gold-hi);
  font-size: 20rpx;
  font-weight: 600;
}
.grank-time {
  color: var(--txt-muted);
  font-size: 20rpx;
  flex-shrink: 0;
}
.grank-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}
.grank-tab {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--panel-glass);
  color: var(--txt-dim);
  font-size: 22rpx;
  font-weight: 600;
}
.grank-tab-on {
  border-color: var(--forge-edge-active);
  background: var(--forge-surface-active);
  color: var(--gold-hi);
}
.grank-tab-a {
  border-color: var(--fac-alliance-line);
  background: var(--fac-alliance-bg);
  color: var(--fac-alliance);
}
.grank-tab-h {
  border-color: var(--fac-horde-line);
  background: var(--fac-horde-bg);
  color: var(--fac-horde);
}
.grank-list {
  margin-top: 12rpx;
}
.grank-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 13rpx 6rpx;
  border-top: 1rpx solid var(--gold-line-soft);
}
.grank-row:first-child {
  border-top: 0;
}
.grank-pos {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: var(--leather);
  color: var(--txt-dim);
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.grank-pos-1 {
  border-color: var(--gold-hot);
  background: var(--gold-hot);
  color: var(--accent-ink);
}
.grank-pos-2 {
  border-color: var(--gold-hi);
  background: var(--forge-surface-active);
  color: var(--gold-hi);
}
.grank-pos-3 {
  border-color: var(--forge-edge);
  background: var(--forge-surface-active);
  color: var(--gold);
}
.grank-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.grank-realm {
  color: var(--txt-title);
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.grank-fac {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 600;
}
.grank-fac-a {
  border: 1rpx solid var(--fac-alliance-line);
  background: var(--fac-alliance-bg);
  color: var(--fac-alliance);
}
.grank-fac-h {
  border: 1rpx solid var(--fac-horde-line);
  background: var(--fac-horde-bg);
  color: var(--fac-horde);
}
.grank-val {
  flex-shrink: 0;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.grank-prefix {
  color: var(--txt-muted);
  font-size: 21rpx;
}
.grank-num {
  color: var(--gold-hi);
  font-size: 29rpx;
  font-weight: 750;
}
.grank-g {
  color: var(--gold);
  font-size: 22rpx;
  font-weight: 700;
}
.grank-empty {
  padding: 26rpx 8rpx 18rpx;
  text-align: center;
  color: var(--txt-muted);
  font-size: 23rpx;
}
.grank-more {
  margin-top: 6rpx;
  padding: 12rpx 0 6rpx;
  border-top: 1rpx solid var(--gold-line-soft);
  text-align: center;
  color: var(--gold-hi);
  font-size: 22rpx;
  font-weight: 600;
}
.grank-note {
  margin-top: 8rpx;
  color: var(--txt-hint);
  font-size: 19rpx;
  text-align: right;
}

@media (prefers-reduced-motion: reduce) {
  .adventure-card, .spotlight, .priority, .feature-selected .feature-body { animation: none; }
  .entry, .feature-tab, .leveling-card, .adventure-main, .adventure-continue { transition: none; }
  .home .entry-pressed { transform: none; }
}

/* 12月10日首批团本筹备横幅（开服倒计时结束后展示） */
.raid-banner {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--forge-surface);
  border: 1rpx solid var(--forge-edge-active);
  border-radius: var(--r-ctl);
  box-shadow: var(--forge-inset), var(--forge-shadow);
}
.raid-banner-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.raid-banner-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.raid-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--accent-ink);
  background: var(--gold-hot);
  padding: 2rpx 10rpx;
  border-radius: var(--r-ctl);
}
.raid-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--txt-title);
}
.raid-arrow {
  font-size: 32rpx;
  color: var(--gold-hi);
}
.raid-banner-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}
.raid-banner-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.raid-chip {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--gold-hi);
  background: var(--sunk);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
}
.raid-chip-warn {
  color: var(--txt-caution);
  border-color: var(--warn);
  background: var(--warn-bg);
}
