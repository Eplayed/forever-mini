/* 控件样式与副本列表页同源（小程序页面样式互相隔离，这里重复一份定义）；
   徽标继续用 app.wxss 的 .badge-L0…L3，不另创。 */

.hero {
  padding: 8rpx 4rpx 20rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
}

.hero-en {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.nameen {
  color: var(--blue);
}

.conflict {
  display: block;
  color: var(--warn);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.hero-meta {
  margin-top: 14rpx;
}

.hero-build {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
  vertical-align: middle;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.actions {
  flex-wrap: wrap;
}

.actions .btn {
  margin-right: 0;
  background: transparent;
}

/* 两个按钮各占一半：站主 2026-10-23 指的那处"排版错位"是三个按钮加一根 spacer
   在一屏宽度里放不下、分享那颗被挤到第二行右边。撤掉复制那颗后仍按两等分排，
   换行与左右不齐这两个问题就都没有立足的地方。 */
.act {
  flex: 1;
  text-align: center;
}

/* 工具条里那颗是 <button open-type="share">——button 自带内边距与行高，
   不重置就会和旁边的 view 按钮高低不齐（微信里"分享"必须是 button，view 触发不了） */
.btn-share {
  height: auto;
  padding: 10rpx 24rpx;
  line-height: 1.4;
  font-size: 24rpx;
  border: 1rpx solid var(--gold);
  border-radius: var(--r-ctl);
  color: var(--gold-hi);
}

.btn-share::after {
  border: 0;
}

/* 任务线以左侧细线串起任务和接取地点。 */
.qsum {
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.quest {
  padding: 14rpx 0 14rpx 16rpx;
  border-left: 4rpx solid var(--gold);
  margin: 10rpx 0 10rpx 4rpx;
}

.quest-name {
  font-size: 26rpx;
}

.quest-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

/* 接取行（2026-11-09 站主要求摆"在哪接的"）：标签压暗、NPC/地点用正文字色；
   缺记录的那句再用暗一档，且语气是"没记录"，不是"没有" */
.quest-pick {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--txt);
}

.pick-k {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: var(--gold);
}

.pick-none {
  color: var(--txt-hint);
}

.frow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.frow:last-child {
  border-bottom: 0;
}

.fkey {
  width: 168rpx;
  color: var(--txt-dim);
  font-size: 24rpx;
  flex-shrink: 0;
}

.fval {
  flex: 1;
  font-size: 26rpx;
}

.fnote {
  margin-top: 2rpx;
}

.route-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--line);
}

.bold {
  color: var(--txt);
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
}

.gold {
  color: var(--gold);
}

.empty {
  text-align: center;
  padding: 40rpx 24rpx;
}

.empty .btn {
  display: inline-block;
  margin: 20rpx 0 0;
}

/* 素材位：图取不到时由 icon-cell 自己回落成自绘块，页面这边只管留位置与说明 */
.hero-art {
  margin-bottom: 16rpx;
}

.art-note {
  font-size: 20rpx;
  color: var(--txt-hint);
  margin-top: 8rpx;
}

/* 品质档名与颜色：档名收在 services/quality.js（与网页端同源），
   颜色用 app.wxss 的 --q1…--q5 令牌。没有品质数的那一档（q 为空）走默认字色，不猜。 */
.q-1 { color: var(--q1); }
.q-2 { color: var(--q2); }
.q-3 { color: var(--q3); }
.q-4 { color: var(--q4); }
.q-5 { color: var(--q5); }

/* 副本地图（M03） */
.map-box {
  margin-bottom: 10rpx;
}

.map-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--txt-hint);
}

.map-entry {
  font-size: 22rpx;
}

/* 副本档案：金色只标可读层级与展开状态，物品品质独立着色。 */
.section-kicker {
  color: var(--gold-hi);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  margin-bottom: 4rpx;
}

.encounter {
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  margin-top: 12rpx;
  background: var(--bg);
}

.encounter-open {
  border-color: var(--gold-line);
}

.encounter-toggle,
.loot-toggle {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx;
  background: transparent;
  color: var(--txt);
  line-height: 1.4;
  text-align: left;
  border-radius: var(--r-ctl);
}

.encounter-open .encounter-toggle,
.encounter-pressed {
  background: var(--gold-glow);
}

.encounter-face,
.loot-icon {
  flex-shrink: 0;
  margin-right: 14rpx;
}

.encounter-other {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: var(--panel);
  color: var(--gold-hi);
  font-size: 24rpx;
}

.encounter-main {
  flex: 1;
  min-width: 0;
}

.encounter-name {
  font-weight: 600;
  font-size: 28rpx;
  color: var(--txt-title);
}

.encounter-meta,
.loot-meta,
.loot-empty {
  margin-top: 4rpx;
  color: var(--txt-dim);
  font-size: 22rpx;
}

.encounter-caret {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx 6rpx 12rpx;
  border-right: 2rpx solid var(--gold-hi);
  border-bottom: 2rpx solid var(--gold-hi);
  transform: rotate(45deg);
  transition: transform 150ms ease-out;
}

.encounter-open .encounter-caret {
  transform: rotate(225deg);
}

.encounter-loot {
  margin: 0 14rpx 10rpx;
  border-top: 1rpx solid var(--gold-line);
}

.loot-entry + .loot-entry {
  border-top: 1rpx solid var(--line);
}

.loot-toggle {
  padding: 12rpx 8rpx;
}

.loot-name {
  font-size: 25rpx;
  overflow-wrap: break-word;
}

.loot-expand {
  flex: 0 0 32rpx;
  color: var(--gold-hi);
  font-size: 26rpx;
  text-align: center;
}

.loot-details {
  padding: 0 8rpx 14rpx 78rpx;
}

.loot-stat {
  color: var(--txt);
  font-size: 23rpx;
  line-height: 1.5;
}

.loot-hit {
  background: var(--gold-glow);
}

.loot-empty {
  padding: 12rpx 4rpx 6rpx;
}

.drop-notice {
  margin-bottom: 12rpx;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-npc {
  color: var(--txt-title);
  font-weight: 600;
  overflow-wrap: break-word;
}

.pick-place {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4rpx 12rpx;
  margin-top: 4rpx;
  color: var(--txt-dim);
}

.pick-coords {
  color: var(--gold-hi);
  white-space: nowrap;
}
