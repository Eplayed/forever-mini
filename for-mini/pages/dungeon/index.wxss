/* 控件样式与副本列表页同源（小程序页面样式互相隔离，这里重复一份定义）；
   徽标继续用 app.wxss 的 .badge-L0…L3，不另创。 */

.hero {
  padding: 8rpx 4rpx 20rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
}

.hero-en {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.nameen {
  color: var(--blue);
}

.conflict {
  display: block;
  color: var(--warn);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.hero-meta {
  margin-top: 14rpx;
}

.hero-build {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
  vertical-align: middle;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.actions {
  flex-wrap: wrap;
}

.actions .btn {
  margin-right: 0;
  background: transparent;
}

/* 两个按钮各占一半：站主 2026-10-23 指的那处"排版错位"是三个按钮加一根 spacer
   在一屏宽度里放不下、分享那颗被挤到第二行右边。撤掉复制那颗后仍按两等分排，
   换行与左右不齐这两个问题就都没有立足的地方。 */
.act {
  flex: 1;
  text-align: center;
}

/* 工具条里那颗是 <button open-type="share">——button 自带内边距与行高，
   不重置就会和旁边的 view 按钮高低不齐（微信里"分享"必须是 button，view 触发不了） */
.btn-share {
  height: auto;
  padding: 10rpx 24rpx;
  line-height: 1.4;
  font-size: 24rpx;
  border: 1rpx solid var(--gold);
  border-radius: var(--r-ctl);
  color: var(--gold-hi);
}

.btn-share::after {
  border: 0;
}

.frow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.frow:last-child {
  border-bottom: 0;
}

.fkey {
  width: 168rpx;
  color: var(--txt-dim);
  font-size: 24rpx;
  flex-shrink: 0;
}

.fval {
  flex: 1;
  font-size: 26rpx;
}

.fnote {
  margin-top: 2rpx;
}

.route-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--line);
}

.boss {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.boss:last-child {
  border-bottom: 0;
}

.boss-main {
  display: flex;
  align-items: center;
}

.boss-name {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.boss-badge {
  margin-left: auto;
}

.boss-note {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.drop {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.drop:last-child {
  border-bottom: 0;
}

.drop-main {
  flex: 1;
  min-width: 0;
}

.drop-name {
  font-size: 26rpx;
  display: block;
}

.drop-boss {
  font-size: 22rpx;
}

.drop-side {
  text-align: right;
  margin-left: 12rpx;
}

.drop-side .badge {
  display: block;
  margin-top: 4rpx;
}

.loot-note {
  margin-top: 14rpx;
  font-size: 22rpx;
}


.bold {
  color: var(--txt);
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
}

.gold {
  color: var(--gold);
}

.empty {
  text-align: center;
  padding: 40rpx 24rpx;
}

.empty .btn {
  display: inline-block;
  margin: 20rpx 0 0;
}

/* 素材位：图取不到时由 icon-cell 自己回落成自绘块，页面这边只管留位置与说明 */
.hero-art {
  margin-bottom: 16rpx;
}

.art-note {
  font-size: 20rpx;
  color: var(--txt-hint);
  margin-top: 8rpx;
}

.boss {
  display: flex;
  align-items: flex-start;
}

.boss-face {
  width: 88rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.drop-face {
  margin-right: 14rpx;
}

/* 品质档名与颜色：档名收在 services/quality.js（与网页端同源），
   颜色用 app.wxss 的 --q1…--q5 令牌。没有品质数的那一档（q 为空）走默认字色，不猜。 */
.q-1 { color: var(--q1); }
.q-2 { color: var(--q2); }
.q-3 { color: var(--q3); }
.q-4 { color: var(--q4); }
.q-5 { color: var(--q5); }

.chev {
  color: var(--txt-hint);
  font-size: 30rpx;
}

/* 来源折叠（2026-10-22 玩家面清理）：来源是红线要求能点开的，
   但它不是玩家第一屏要看的东西，所以收进一个开关里。 */
.prov-head {
  display: flex;
  align-items: center;
}

.prov-toggle {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
}

/* 掉落按首领分组 + 反查高亮（M03） */
.dgrp {
  margin-bottom: 16rpx;
}

.dgrp-h {
  padding: 8rpx 14rpx;
  margin-bottom: 6rpx;
  background: var(--panel-2);
  border-left: 4rpx solid var(--gold);
  font-size: 24rpx;
  color: var(--gold-hi);
}

.drop-notice {
  margin-bottom: 12rpx;
}

.drop-hit {
  border: 1rpx solid var(--gold);
  background: var(--gold-glow);
  border-radius: 10rpx;
}

/* 副本地图（M03） */
.map-box {
  margin-bottom: 10rpx;
}

.map-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--txt-hint);
}

.map-entry {
  font-size: 22rpx;
}
