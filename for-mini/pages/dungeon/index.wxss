/* 控件样式与副本列表页同源（小程序页面样式互相隔离，这里重复一份定义）；
   徽标继续用 app.wxss 的 .badge-L0…L3，不另创。 */

.hero {
  padding: 8rpx 4rpx 20rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
}

.hero-en {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.nameen {
  color: var(--blue);
}

.conflict {
  display: block;
  color: var(--warn);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.hero-meta {
  margin-top: 14rpx;
}

.hero-build {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

.todo {
  color: var(--lead);
  font-size: 20rpx;
  margin-left: 8rpx;
  border: 1rpx dashed var(--lead);
  border-radius: 8rpx;
  padding: 0 8rpx;
  vertical-align: middle;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.actions {
  flex-wrap: wrap;
}

.actions .btn {
  margin-right: 0;
  background: transparent;
}

/* 两个按钮各占一半：站主 2026-10-23 指的那处"排版错位"是三个按钮加一根 spacer
   在一屏宽度里放不下、分享那颗被挤到第二行右边。撤掉复制那颗后仍按两等分排，
   换行与左右不齐这两个问题就都没有立足的地方。 */
.act {
  flex: 1;
  text-align: center;
}

/* 工具条里那颗是 <button open-type="share">——button 自带内边距与行高，
   不重置就会和旁边的 view 按钮高低不齐（微信里"分享"必须是 button，view 触发不了） */
.btn-share {
  height: auto;
  padding: 10rpx 24rpx;
  line-height: 1.4;
  font-size: 24rpx;
  border: 1rpx solid var(--gold);
  border-radius: var(--r-ctl);
  color: var(--gold-hi);
}

.btn-share::after {
  border: 0;
}

/* 任务线以左侧细线串起任务和接取地点。 */
.qsum {
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.quest {
  padding: 14rpx 0 14rpx 16rpx;
  border-left: 4rpx solid var(--gold);
  margin: 10rpx 0 10rpx 4rpx;
}

.quest-name {
  font-size: 26rpx;
}

.quest-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--txt-dim);
}

/* 接取行（2026-11-09 站主要求摆"在哪接的"）：标签压暗、NPC/地点用正文字色；
   缺记录的那句再用暗一档，且语气是"没记录"，不是"没有" */
.quest-pick {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--txt);
}

.pick-k {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: var(--gold);
}

.pick-none {
  color: var(--txt-hint);
}

.frow {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.frow:last-child {
  border-bottom: 0;
}

.fkey {
  width: 168rpx;
  color: var(--txt-dim);
  font-size: 24rpx;
  flex-shrink: 0;
}

.fval {
  flex: 1;
  font-size: 26rpx;
}

.fnote {
  margin-top: 2rpx;
}

.route-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--line);
}

.bold {
  color: var(--txt);
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
}

.gold {
  color: var(--gold);
}

.empty {
  text-align: center;
  padding: 40rpx 24rpx;
}

.empty .btn {
  display: inline-block;
  margin: 20rpx 0 0;
}

/* 素材位：图取不到时由 icon-cell 自己回落成自绘块，页面这边只管留位置与说明 */
.hero-art {
  margin-bottom: 16rpx;
}

.art-note {
  font-size: 20rpx;
  color: var(--txt-hint);
  margin-top: 8rpx;
}

/* 品质档名与颜色：档名收在 services/quality.js（与网页端同源），
   颜色用 app.wxss 的 --q1…--q5 令牌。没有品质数的那一档（q 为空）走默认字色，不猜。 */
.q-1 { color: var(--q1); }
.q-2 { color: var(--q2); }
.q-3 { color: var(--q3); }
.q-4 { color: var(--q4); }
.q-5 { color: var(--q5); }

/* 副本地图（M03 + 2026-11-24 全图展示、点开放大与新本首领序号点位） */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.map-zoom-hint {
  font-size: 22rpx;
  color: var(--gold-hi);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--gold-line);
  border-radius: 999rpx;
  background: var(--gold-glow);
}

.map-box {
  margin-bottom: 10rpx;
}

.map-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: var(--r-ctl);
  border: 1rpx solid var(--line-2);
  background: var(--bg);
}

.map-img {
  width: 100%;
  display: block;
}

.map-pin {
  position: absolute;
  transform: translate(-50%, -50%);
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 2rpx solid var(--gold);
  background: var(--foot);
  color: var(--gold-hot);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-shadow: var(--forge-shadow);
  pointer-events: none;
}

.map-fallback {
  padding: 28rpx 16rpx;
  margin-bottom: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--txt-dim);
  border: 1rpx dashed var(--line-2);
  border-radius: var(--r-ctl);
  background: var(--bg);
}

.map-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--txt-hint);
}

.map-entry {
  font-size: 22rpx;
}

/* 副本档案：金色只标可读层级与展开状态，物品品质独立着色。 */
.section-kicker {
  color: var(--gold-hi);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  margin-bottom: 4rpx;
}

.encounter {
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  margin-top: 12rpx;
  background: var(--bg);
}

.encounter-open {
  border-color: var(--gold-line);
}

.encounter-toggle,
.loot-toggle {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx;
  background: transparent;
  color: var(--txt);
  line-height: 1.4;
  text-align: left;
  border-radius: var(--r-ctl);
}

.encounter-open .encounter-toggle,
.encounter-pressed {
  background: var(--gold-glow);
}

.encounter-seq {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--gold-line);
  background: var(--leather);
  color: var(--gold-hi);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.encounter-face,
.loot-icon {
  flex-shrink: 0;
  margin-right: 14rpx;
}

.encounter-other {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: var(--panel);
  color: var(--gold-hi);
  font-size: 24rpx;
}

.encounter-main {
  flex: 1;
  min-width: 0;
}

.encounter-name {
  font-weight: 600;
  font-size: 28rpx;
  color: var(--txt-title);
}

.encounter-meta,
.loot-meta,
.loot-empty {
  margin-top: 4rpx;
  color: var(--txt-dim);
  font-size: 22rpx;
}

.encounter-caret {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx 6rpx 12rpx;
  border-right: 2rpx solid var(--gold-hi);
  border-bottom: 2rpx solid var(--gold-hi);
  transform: rotate(45deg);
  transition: transform 150ms ease-out;
}

.encounter-open .encounter-caret {
  transform: rotate(225deg);
}

.encounter-loot {
  margin: 0 14rpx 10rpx;
  border-top: 1rpx solid var(--gold-line);
}

.loot-entry + .loot-entry {
  border-top: 1rpx solid var(--line);
}

.loot-toggle {
  padding: 12rpx 8rpx;
}

.loot-name {
  font-size: 25rpx;
  overflow-wrap: break-word;
}

.loot-expand {
  flex: 0 0 32rpx;
  color: var(--gold-hi);
  font-size: 26rpx;
  text-align: center;
}

.loot-details {
  padding: 0 8rpx 14rpx 78rpx;
}

.loot-stat {
  color: var(--txt);
  font-size: 23rpx;
  line-height: 1.5;
}

.loot-hit {
  background: var(--gold-glow);
}

.loot-empty {
  padding: 12rpx 4rpx 6rpx;
}

.drop-notice {
  margin-bottom: 12rpx;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-npc {
  color: var(--txt-title);
  font-weight: 600;
  overflow-wrap: break-word;
}

.pick-place {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4rpx 12rpx;
  margin-top: 4rpx;
  color: var(--txt-dim);
}

.pick-coords {
  color: var(--gold-hi);
  white-space: nowrap;
}

.goal-button { display: inline-flex; align-items: center; justify-content: center; min-height: 80rpx; margin: 0; padding: 8rpx 16rpx; border: 1rpx solid var(--gold-line); border-radius: 8rpx; background: var(--sunk); color: var(--gold-hi); font-size: 24rpx; line-height: 1.35; white-space: nowrap; }
.goal-button::after { border: 0; }
.loot-details .goal-button, .plan-actions { margin-top: 12rpx; }
.plan-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.plan-actions .faction-on { border-color: var(--gold-deep); background: var(--gold-glow); }
.quest-region { margin: 20rpx 0 8rpx; color: var(--gold-hi); font-size: 24rpx; font-weight: 700; }

/* 12月10日团本开荒档案与黑龙门任务打卡（仅用 app.wxss 令牌） */
.raid-guide-card {
  background: var(--forge-surface);
  border: 1rpx solid var(--forge-edge-active);
}
.raid-guide-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.raid-guide-title {
  margin-bottom: 0;
  color: var(--gold-hi);
}
.raid-guide-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: var(--r-ctl);
  border: 1rpx solid var(--line);
}
.raid-badge-ok {
  color: var(--ok);
  border-color: var(--ok);
}
.raid-badge-warn {
  color: var(--txt-caution);
  border-color: var(--warn);
  background: var(--warn-bg);
}
.raid-guide-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.raid-guide-k {
  flex-shrink: 0;
  color: var(--gold);
  font-weight: 600;
}
.raid-guide-v {
  color: var(--txt);
}
.raid-guide-tip {
  font-size: 23rpx;
  color: var(--txt-dim);
  line-height: 1.55;
  margin-top: 4rpx;
}
.raid-guide-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.raid-guide-btn {
  flex: 1;
  min-width: 240rpx;
  text-align: center;
  padding: 12rpx 14rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--gold-hi);
  background: var(--sunk);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
}
.raid-guide-btn-gold {
  color: var(--accent-ink);
  background: var(--gold);
  border-color: var(--gold-hi);
}

.attune-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.attune-title {
  margin-bottom: 0;
  color: var(--gold-hi);
}
.attune-prog {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--gold-hi);
}
.attune-note {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.attune-tabs {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.attune-tab {
  padding: 8rpx 18rpx;
  font-size: 23rpx;
  color: var(--txt-dim);
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}
.attune-tab-a {
  color: var(--fac-alliance);
  border-color: var(--fac-alliance-line);
  background: var(--fac-alliance-bg);
  font-weight: 700;
}
.attune-tab-h {
  color: var(--fac-horde);
  border-color: var(--fac-horde-line);
  background: var(--fac-horde-bg);
  font-weight: 700;
}
.attune-reset {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--txt-muted);
  padding: 6rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}
.attune-bar {
  height: 10rpx;
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
  overflow: hidden;
  margin-bottom: 14rpx;
}
.attune-fill {
  height: 100%;
  background: var(--ok);
}
.attune-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx 12rpx;
  margin-bottom: 10rpx;
  background: var(--sunk);
  border: 1rpx solid var(--line);
  border-radius: var(--r-ctl);
}
.attune-row-done {
  border-color: var(--ok);
  opacity: 0.72;
}
.attune-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.attune-box {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gold-hi);
  background: var(--panel);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--r-ctl);
}
.attune-box-on {
  color: var(--accent-ink);
  background: var(--ok);
  border-color: var(--ok);
}
.attune-copy {
  flex: 1;
  min-width: 0;
}
.attune-q {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--txt-title);
}
.attune-row-done .attune-q {
  text-decoration: line-through;
  color: var(--txt-muted);
}
.attune-sub {
  font-size: 21rpx;
  color: var(--azure);
  margin-top: 2rpx;
}
.attune-desc {
  font-size: 22rpx;
  color: var(--txt-dim);
  margin-top: 4rpx;
  line-height: 1.45;
}
.attune-go {
  flex-shrink: 0;
  align-self: center;
  padding: 6rpx 12rpx;
  font-size: 21rpx;
  color: var(--gold-hi);
  border: 1rpx solid var(--gold-line);
  background: var(--panel);
  border-radius: var(--r-ctl);
}
