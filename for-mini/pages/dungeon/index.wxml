<view class="wrap">
  <view wx:if="{{notFound}}" class="card empty">
    <view>未找到该副本。</view>
    <view class="btn gold" bindtap="onBack">回到副本列表</view>
  </view>

  <block wx:elif="{{loaded}}">
    <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
      请更新小程序以查看最新资料。
    </view>
    <view wx:elif="{{needOnline}}" class="notice">
      联网查看首领名单和掉落。
    </view>
    <view wx:elif="{{offline}}" class="notice">
      当前离线，显示已保存的内容。
    </view>

    <view class="hero">
      <view class="hero-art">
        <icon-cell src="{{artUrl}}" size="hero" fallback-text="这座还没有原画" />
      </view>
      <view class="hero-title">
        {{title}}
        <text wx:if="{{nameMissing}}" class="todo">中文名待核</text>
      </view>
      <view class="muted hero-en">
        <text wx:if="{{!enMissing}}" class="nameen">{{nameEn}}</text>
        <text wx:else class="todo">英文名待补</text>
      </view>
      <view class="hero-meta">
        <text class="tag">{{kindLabel}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row actions">
        <view class="btn act {{fav ? 'btn-on' : ''}}" bindtap="onFav">{{fav ? '★ 已收藏' : '☆ 收藏'}}</view>
        <button class="btn act btn-share" open-type="share">分享给微信好友</button>
      </view>
    </view>

    <view wx:if="{{mapUrl || mapEntry}}" class="card">
      <view class="card-title">副本地图</view>
      <view wx:if="{{mapUrl}}" class="map-box">
        <icon-cell src="{{mapUrl}}" size="hero" label="{{title}}" fallback-text="这座还没有内部底图" />
      </view>
      <view wx:if="{{mapEntry}}" class="muted map-entry">{{mapEntry}}</view>
    </view>

    <view class="card">
      <view class="card-title">副本信息</view>
      <view class="frow" wx:for="{{rows}}" wx:key="k">
        <view class="fkey">{{item.k}}</view>
        <view class="fval">
          <view>{{item.v}}</view>
          <view wx:if="{{item.note}}" class="muted fnote">{{item.note}}</view>
        </view>
      </view>
    </view>

    <view class="card encounter-card">
      <view class="section-kicker">副本档案</view>
      <view class="card-title">首领与掉落</view>
      <view wx:if="{{dropNotice}}" class="notice drop-notice">{{dropNotice}}</view>
      <view wx:if="{{bossEmpty}}" class="muted">{{bossEmpty}}</view>
      <view wx:elif="{{needOnline && !bosses.length}}" class="muted">首领名单要联网才能取。</view>
      <view wx:for="{{bosses}}" wx:key="id" class="encounter {{openBoss === item.id ? 'encounter-open' : ''}}">
        <view class="encounter-toggle" hover-class="encounter-pressed" data-id="{{item.id}}" aria-role="button"
                aria-expanded="{{openBoss === item.id}}" bindtap="onToggleBoss">
          <view class="encounter-face">
            <icon-cell wx:if="{{!item.other}}" src="{{item.portraitUrl}}" size="md" label="{{item.name}}" />
            <text wx:else class="encounter-other">余</text>
          </view>
          <view class="encounter-main">
            <view class="encounter-name">{{item.name}}<text wx:if="{{item.missing}}" class="todo">待核</text></view>
            <view class="encounter-meta">
              {{lootState === 'ready' ? (item.items.length ? item.items.length + ' 条掉落' : '掉落待实测') : '掉落暂未加载'}}
            </view>
          </view>
          <view class="encounter-caret" aria-hidden="true"></view>
        </view>
        <view wx:if="{{openBoss === item.id}}" class="encounter-loot">
          <view wx:if="{{lootState !== 'ready'}}" class="loot-empty">掉落暂未取到，联网后下拉刷新。</view>
          <view wx:elif="{{!item.items.length}}" class="loot-empty">这位首领的掉落待实测。</view>
          <block wx:for="{{item.items}}" wx:for-item="row" wx:key="key">
            <view class="loot-entry {{highlightDrop && row.itemId === highlightDrop ? 'loot-hit' : ''}}">
              <view class="loot-toggle" hover-class="encounter-pressed" bindtap="onToggleItem" aria-role="button"
                      aria-expanded="{{openItem === row.key}}" data-key="{{row.key}}" data-item="{{row.itemId}}">
                <view class="loot-icon"><icon-cell src="{{row.iconUrl}}" size="sm" label="{{row.name}}" /></view>
                <view class="encounter-main">
                  <view class="loot-name q-{{row.q}}">{{row.name}}<text wx:if="{{row.missing}}" class="todo">中文名待核</text></view>
                  <view class="loot-meta">{{row.quality}}{{row.boss ? ' · ' + row.boss : ''}}</view>
                </view>
                <text class="loot-expand" aria-hidden="true">{{openItem === row.key ? '−' : '+'}}</text>
              </view>
              <view wx:if="{{openItem === row.key}}" class="loot-details">
                <view wx:if="{{itemCard.type || itemCard.ilvl}}" class="loot-meta">
                  <text>{{itemCard.type}}</text><text wx:if="{{itemCard.ilvl}}">{{itemCard.type ? ' · ' : ''}}装等 {{itemCard.ilvl}}</text>
                </view>
                <view wx:for="{{itemCard.st}}" wx:for-item="stat" wx:key="index" class="loot-stat">{{stat}}</view>
                <view wx:if="{{!itemCard.st.length}}" class="loot-meta">属性待实测</view>
                <view wx:if="{{itemCard.sell}}" class="loot-meta">商人卖价 {{itemCard.sell}}</view>
                <view wx:if="{{row.itemId}}" class="loot-meta">物品编号 <text class="mono">{{row.itemId}}</text></view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>

    <view class="card quest-card">
      <view class="section-kicker">接取路线</view>
      <view class="card-title">这座本的任务</view>
      <view wx:if="{{needOnline}}" class="muted">联网后可查看任务。</view>
      <block wx:else>
        <view wx:if="{{quest.summary}}" class="muted qsum">{{quest.summary}}</view>
        <view wx:if="{{quest.empty}}" class="muted">{{quest.empty}}</view>
        <view class="quest" wx:for="{{quest.rows}}" wx:key="index">
          <text class="quest-name">{{item.name}}<text wx:if="{{item.missing}}" class="todo">译名待核</text></text>
          <view wx:if="{{item.meta}}" class="quest-meta">{{item.meta}}</view>
          <view class="quest-pick">
            <text class="pick-k">{{item.startItem ? '物品开启' : '接取'}}</text>
            <view class="pick-body">
              <view class="{{item.pickupNpc || item.startItem ? 'pick-npc' : 'pick-none'}}">{{item.pickupNpc || item.startItem || '接取人待实测'}}</view>
              <view wx:if="{{!item.startItem || item.pickupZone}}" class="pick-place">
                <text>{{item.pickupZone || '地点待实测'}}</text>
                <text wx:if="{{item.pickupCoords}}" class="pick-coords">{{item.pickupMap ? item.pickupMap + ' ' : ''}}<text class="mono">{{item.pickupCoords}}</text></text>
                <text wx:elif="{{!item.startItem}}" class="pick-none">坐标待实测</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
  </block>

  <view wx:else class="card muted">正在取这座本的详情…</view>
</view>
