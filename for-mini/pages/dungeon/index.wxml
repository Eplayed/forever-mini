<view class="wrap">
  <view wx:if="{{notFound}}" class="card empty">
    <view>未找到该副本。</view>
    <view class="btn gold" bindtap="onBack">回到副本列表</view>
  </view>

  <block wx:elif="{{loaded}}">
    <view wx:if="{{requiresUpdate}}" class="notice notice-bad">
      请更新小程序以查看最新资料。
    </view>
    <view wx:elif="{{needOnline}}" class="notice">
      联网查看首领名单和掉落。
    </view>
    <view wx:elif="{{offline}}" class="notice">
      当前离线，显示已保存的内容。
    </view>

    <view class="hero">
      <view class="hero-art" bindtap="onPreviewArt">
        <icon-cell src="{{artUrl}}" size="hero" fallback-text="这座还没有原画" />
      </view>
      <view class="hero-title">
        {{title}}
        <text wx:if="{{nameMissing}}" class="todo">中文名待核</text>
      </view>
      <view class="muted hero-en">
        <text wx:if="{{!enMissing}}" class="nameen">{{nameEn}}</text>
        <text wx:else class="todo">英文名待补</text>
      </view>
      <view class="hero-meta">
        <text class="tag">{{kindLabel}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row actions">
        <view class="btn act {{fav ? 'btn-on' : ''}}" bindtap="onFav">{{fav ? '★ 已收藏' : '☆ 收藏'}}</view>
        <button class="btn act btn-share" open-type="share">分享给微信好友</button>
      </view>
      <view class="plan-actions">
        <button size="mini" class="goal-button" bindtap="onPlanDungeon">{{planned ? '已计划 · 查看清单 ›' : '＋ 跑本计划'}}</button>
        <button size="mini" wx:if="{{quest.rows.length || hasFactions}}" class="goal-button" bindtap="scrollToTasks">看任务接取 ↓</button>
      </view>
    </view>

    <view wx:if="{{mapUrl || mapEntry}}" class="card">
      <view class="card-head">
        <view class="card-title">{{mapTitle}}</view>
        <text wx:if="{{mapUrl && !mapBroken}}" class="map-zoom-hint" bindtap="onPreviewMap">点击放大</text>
      </view>
      <view wx:if="{{mapUrl && !mapBroken}}" class="map-box" bindtap="onPreviewMap" aria-role="button" aria-label="点击放大查看{{mapTitle}}">
        <view class="map-stage">
          <image class="map-img" src="{{mapUrl}}" mode="widthFix" lazy-load binderror="onMapError" />
          <view wx:for="{{mapPins}}" wx:key="key" class="map-pin mono" style="left:{{item.x}}%;top:{{item.y}}%;">{{item.seq}}</view>
        </view>
      </view>
      <view wx:elif="{{mapUrl && mapBroken}}" class="map-fallback">底图暂未加载，下拉刷新重试</view>
      <view wx:if="{{mapEntry}}" class="muted map-entry">{{mapEntry}}</view>
    </view>

    <view class="card">
      <view class="card-title">副本信息</view>
      <view class="frow" wx:for="{{rows}}" wx:key="k">
        <view class="fkey">{{item.k}}</view>
        <view class="fval">
          <view>{{item.v}}</view>
          <view wx:if="{{item.note}}" class="muted fnote">{{item.note}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{raidGuide}}" class="card raid-guide-card">
      <view class="raid-guide-hd">
        <view class="card-title raid-guide-title">{{raidGuide.title}}</view>
        <text class="raid-guide-badge {{raidGuide.attunementRequired ? 'raid-badge-warn' : 'raid-badge-ok'}}">
          {{raidGuide.attunementRequired ? '需' + (raidGuide.attunementItem || '门任务') : '无需门任务'}}
        </text>
      </view>
      <view wx:if="{{raidGuide.entrances}}" class="raid-guide-row">
        <text class="raid-guide-k">入口路线</text>
        <text class="raid-guide-v">{{raidGuide.entrances}}</text>
      </view>
      <view wx:if="{{raidGuide.attunementNote}}" class="raid-guide-row">
        <text class="raid-guide-k">进本条件</text>
        <text class="raid-guide-v">{{raidGuide.attunementNote}}</text>
      </view>
      <view wx:for="{{raidGuide.prepTips}}" wx:key="index" class="raid-guide-tip">· {{item}}</view>
      <view class="raid-guide-btns">
        <view class="raid-guide-btn" bindtap="onGoBis60">60级团前 BiS & 一图流 ›</view>
        <view wx:if="{{raidGuide.hasT1Sets}}" class="raid-guide-btn raid-guide-btn-gold" bindtap="onGoT1">海加尔峰 18 套 T1 ›</view>
      </view>
    </view>

    <view wx:if="{{attune && attuneSteps.length}}" class="card attune-card" id="raid-attunement">
      <view class="attune-hd">
        <view class="card-title attune-title">龙火护符开门任务</view>
        <text class="attune-prog mono">{{attuneDoneCount}} / {{attuneSteps.length}}</text>
      </view>
      <view class="muted attune-note">{{attune.bagRule}} 点击步骤即可勾选记录进度。</view>
      <view class="attune-tabs">
        <view class="attune-tab {{attuneFac === 'alliance' ? 'attune-tab-a' : ''}}" data-fac="alliance" bindtap="onPickAttuneFac">联盟（{{attune.alliance.length}}步）</view>
        <view class="attune-tab {{attuneFac === 'horde' ? 'attune-tab-h' : ''}}" data-fac="horde" bindtap="onPickAttuneFac">部落（{{attune.horde.length}}步）</view>
        <view wx:if="{{attuneDoneCount > 0}}" class="attune-reset" bindtap="onResetAttune">重置</view>
      </view>
      <view class="attune-bar">
        <view class="attune-fill" style="width:{{attunePct}}%;"></view>
      </view>
      <view wx:for="{{attuneSteps}}" wx:key="id" class="attune-row {{item.done ? 'attune-row-done' : ''}}">
        <view class="attune-main" data-id="{{item.id}}" bindtap="onToggleAttuneStep">
          <view class="attune-box {{item.done ? 'attune-box-on' : ''}}">{{item.done ? '✓' : item.step}}</view>
          <view class="attune-copy">
            <view class="attune-q">{{item.questCn}}</view>
            <view class="attune-sub">{{item.zone}}{{item.npc ? ' · ' + item.npc : ''}}</view>
            <view class="attune-desc">{{item.summary}}</view>
          </view>
        </view>
        <view wx:if="{{item.dungeonId}}" class="attune-go" data-id="{{item.dungeonId}}" catchtap="onOpenLinkedDungeon">看副本 ›</view>
      </view>
    </view>

    <view class="card encounter-card">
      <view class="section-kicker">副本档案</view>
      <view class="card-title">首领与掉落</view>
      <view wx:if="{{dropNotice}}" class="notice drop-notice">{{dropNotice}}</view>
      <view wx:if="{{bossEmpty}}" class="muted">{{bossEmpty}}</view>
      <view wx:elif="{{needOnline && !bosses.length}}" class="muted">首领名单要联网才能取。</view>
      <view wx:for="{{bosses}}" wx:key="id" class="encounter {{openBoss === item.id ? 'encounter-open' : ''}}">
        <view class="encounter-toggle" hover-class="encounter-pressed" data-id="{{item.id}}" aria-role="button"
                aria-expanded="{{openBoss === item.id}}" bindtap="onToggleBoss">
          <view wx:if="{{!item.other}}" class="encounter-seq mono">{{item.seq}}</view>
          <view class="encounter-face">
            <icon-cell wx:if="{{!item.other}}" src="{{item.portraitUrl}}" size="md" label="{{item.name}}" />
            <text wx:else class="encounter-other">余</text>
          </view>
          <view class="encounter-main">
            <view class="encounter-name">{{item.name}}<text wx:if="{{item.missing}}" class="todo">待核</text></view>
            <view class="encounter-meta">
              {{lootState === 'ready' ? (item.items.length ? item.items.length + ' 条掉落' : '掉落待实测') : '掉落暂未加载'}}
            </view>
          </view>
          <view class="encounter-caret" aria-hidden="true"></view>
        </view>
        <view wx:if="{{openBoss === item.id}}" class="encounter-loot">
          <view wx:if="{{lootState !== 'ready'}}" class="loot-empty">掉落暂未取到，联网后下拉刷新。</view>
          <view wx:elif="{{!item.items.length}}" class="loot-empty">这位首领的掉落待实测。</view>
          <block wx:for="{{item.items}}" wx:for-item="row" wx:key="key">
            <view id="goal-drop-{{row.key}}" class="loot-entry {{highlightDrop && row.itemId === highlightDrop ? 'loot-hit' : ''}}">
              <view class="loot-toggle" hover-class="encounter-pressed" bindtap="onToggleItem" aria-role="button"
                      aria-expanded="{{openItem === row.key}}" data-key="{{row.key}}" data-item="{{row.itemId}}">
                <view class="loot-icon"><icon-cell src="{{row.iconUrl}}" size="sm" label="{{row.name}}" /></view>
                <view class="encounter-main">
                  <view class="loot-name q-{{row.q}}">{{row.name}}<text wx:if="{{row.missing}}" class="todo">中文名待核</text></view>
                  <view class="loot-meta">{{row.quality}}{{row.boss ? ' · ' + row.boss : ''}}</view>
                </view>
                <text class="loot-expand" aria-hidden="true">{{openItem === row.key ? '−' : '+'}}</text>
              </view>
              <view wx:if="{{openItem === row.key}}" class="loot-details">
                <view wx:if="{{itemCard.type || itemCard.ilvl}}" class="loot-meta">
                  <text>{{itemCard.type}}</text><text wx:if="{{itemCard.ilvl}}">{{itemCard.type ? ' · ' : ''}}装等 {{itemCard.ilvl}}</text>
                </view>
                <view wx:for="{{itemCard.st}}" wx:for-item="stat" wx:key="index" class="loot-stat">{{stat}}</view>
                <view wx:if="{{!itemCard.st.length}}" class="loot-meta">属性待实测</view>
                <view wx:if="{{itemCard.sell}}" class="loot-meta">商人卖价 {{itemCard.sell}}</view>
                <view wx:if="{{row.itemId}}" class="loot-meta">物品编号 <text class="mono">{{row.itemId}}</text></view>
                <button size="mini" wx:if="{{row.itemId}}" class="goal-button" bindtap="onAddGear">{{itemSaved ? '已加入 · 查看清单 ›' : '＋ 想要'}}</button>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>

    <view class="card quest-card" id="dungeon-quests">
      <view class="card-title">任务接取路线</view>
      <view wx:if="{{needOnline}}" class="muted">联网后可查看任务。</view>
      <block wx:else>
        <view wx:if="{{hasFactions}}" class="plan-actions">
          <button size="mini" class="goal-button {{!faction ? 'faction-on' : ''}}" data-faction="" bindtap="pickQuestFaction">全部</button>
          <button size="mini" class="goal-button {{faction === 'alliance' ? 'faction-on' : ''}}" data-faction="alliance" bindtap="pickQuestFaction">联盟</button>
          <button size="mini" class="goal-button {{faction === 'horde' ? 'faction-on' : ''}}" data-faction="horde" bindtap="pickQuestFaction">部落</button>
        </view>
        <view wx:if="{{quest.empty}}" class="muted">{{quest.empty}}</view>
        <block wx:for="{{quest.rows}}" wx:key="key">
          <view wx:if="{{item.header}}" class="quest-region">{{item.header}}</view>
          <view class="quest">
            <text class="quest-name">{{item.name}}<text wx:if="{{item.missing}}" class="todo">译名待核</text></text>
            <view wx:if="{{item.faction || item.reqLevel}}" class="quest-meta">
              {{item.faction}}{{item.faction && item.reqLevel ? ' · ' : ''}}{{item.reqLevel ? '需 ' + item.reqLevel + ' 级' : ''}}
            </view>
            <view class="quest-pick">
              <text class="pick-k">{{item.startItem ? '物品开启' : '接取'}}</text>
              <view class="pick-body">
                <view class="{{item.pickupNpc || item.startItem ? 'pick-npc' : 'pick-none'}}">{{item.startItem || item.pickupNpc || '接取人待实测'}}</view>
                <view wx:if="{{item.location || item.pickupCoords}}" class="pick-place">
                  <text>{{item.location}}</text>
                  <text wx:if="{{item.pickupCoords}}" class="pick-coords mono">{{item.pickupCoords}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{item.preQuest}}" class="quest-meta">前置：{{item.preQuest}}</view>
          </view>
        </block>
      </block>
    </view>

    <view class="foot">非官方粉丝资料站，与暴雪娱乐及网易无关。</view>
  </block>

  <view wx:else class="card muted">正在取这座本的详情…</view>
</view>
